{"school":{"dbn":"32K376","name":"P.S. 376","boro":"Brooklyn","district":"32","district_label":"District 32","report_type":"EMS","report_types":"EMS","school_type":"Elementary","grades":"K-5","status":"open","enrollment":468,"enrollment_year":"2024-25","address":"194 HARMAN STREET, Brooklyn, NY 11237","phone":"718-573-0781","website":"WWW.PS376.ORG","directory_url":"https://www.myschools.nyc/en/schools/kindergarten/68670","accessibility":"Fully Accessible","overview":"PS 376 is a school committed to academic excellence and the development of 21st-century skills through an integrated Science, Technology, Engineering, Arts, and Math (STEAM) program. We offer Dual Language English & Spanish programs and Gifted and Talented classes for grades K-5, supporting an inclusive and culturally rich curriculum.\n\nOur students engage in authentic, inquiry-based learning that fosters critical thinking, collaboration, and exploration of real-world issues. Our science lab features a hydroponic garden, where students explore sustainable agriculture and plant science hands-on, connecting their learning to larger environmental concepts. Additionally, students develop environmental awareness and stewardship skills in our community garden on Himrod and Wilson Avenue. Our arts programming provides multiple opportunities throughout the school year for students to express themselves creatively. Through our theater program, students explore storytelling and performance, building confidence and collaboration skills. Our dance program encourages physical expression and fosters a sense of community among students as they celebrate diverse styles and cultures. Our media arts program fosters creative expression across multiple media forms, helping students develop a range of artistic skills. The STEAM club provides unique opportunities for students to compete in Minecraft coding challenges across NYC. Additionally, our soccer club offers students the chance to engage beyond the school walls by participating in tournaments around Brooklyn, building teamwork and sportsmanship.\n No additional priority is given to zoned students for the Gifted & Talented program at this school.","start_time":"8:00 AM","end_time":"2:20 PM","languages":"Spanish","subway":"L to DeKalb Av; M to Knickerbocker Av","bus":"B13, B26, B38, B52, B54, B60, Q55, Q58","shared_building":"0","neighborhood":null,"latitude":40.6982,"longitude":-73.9202,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.928],"n":[366.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.94,0.947,0.941,0.921,0.907,0.91,0.919],"n":[555.0,537.0,499.0,489.0,529.0,552.0,497.0],"c":[null,null,null,null,null,0.881,0.885]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.947],"n":[496.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.841,0.834,0.819,0.826,0.856,0.807,0.737,0.65,0.689,0.725],"n":[579.0,572.0,530.0,541.0,529.0,487.0,483.0,514.0,549.0,483.0],"c":[0.798,0.789,0.759,0.801,null,null,null,0.627,0.633,0.652],"s":[3.43,3.0,3.67,4.14,null,null,null,3.15,4.08,4.38],"b":["above","above","above","high",null,null,null,"above","high","high"]},"chronic_absent_ems_allea":{"y":["2019-20"],"v":[1.0],"n":[15.0]},"chronic_absent_ems_alleb":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.867,0.889,0.795,0.725,0.511,0.684,0.704],"n":[45.0,36.0,39.0,40.0,47.0,38.0,27.0],"c":[0.836,null,null,null,null,null,null]},"chronic_absent_ems_alleh":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.819,0.843,0.79,0.714,0.65,0.672,0.704],"n":[459.0,446.0,396.0,391.0,408.0,442.0,399.0],"c":[0.797,null,null,null,null,null,null]},"chronic_absent_ems_allei":{"y":["2024-25"],"v":[null],"st":["suppressed"],"n":[3.0]},"chronic_absent_ems_alle