{"school":{"dbn":"05M092","name":"P.S. 092 Mary McLeod Bethune","boro":"Manhattan","district":"05","district_label":"District 5","report_type":"EMS","report_types":"EMS","school_type":"Elementary","grades":"PK-5","status":"open","enrollment":175,"enrollment_year":"2024-25","address":"222 WEST 134 STREET, MANHATTAN, NY 10030","phone":"212-690-5915","website":"WEAREBETHUNE92.ORG","directory_url":"https://www.myschools.nyc/en/schools/kindergarten/65894","accessibility":"Fully Accessible","overview":"Welcome to Mary McLeod Bethune School/P.S. 92.  Kindergarten is a special time in a students life and choosing the right school for your scholar is crucial.  Parents trust their most precious children to schools for various reasons.  Send your child to Bethune because our Bethune family truly cares for children.  We are a small, tight knit school with staff who are committed to enriching the lives of children.  Our mission is aligned to the legacy of Mary McLeod Bethune to encourage our youth, recognize their potential, and to help them build a better world.  A feeling of belonging is important to us and we recognize and celebrate the diversity within our school building.  We expose all students to performance arts and visual arts in addition to their daily academics.  We believe in health and wellness for students as well as staff.  At Bethune, your child will be known by name by all and greeted warmly daily.  We will communicate with you often and invite you in to learn alongside us. New York City helps to shape our classrooms.  Our students experience a number of field trips aligned to our curriculum and health and wellness.  We invite you to make outreach to set up a tour of our beautiful school. The Autism Horizon Program supports students with autism in a special class with eight students, a special education teacher and paraprofessional with emphasis on building skills and offering opportunities for meaningful inclusion in larger settings. Students in this program may need additional academic support and require speech and language services, including in areas of social or pragmatic communication. For more information, speak with your CSE or IEP team and refer to Specialized Programs for Students with Disabilities (nyc.gov).","start_time":"8:00 AM","end_time":"2:20 PM","languages":null,"subway":"A, D to 125th St; B, C to 135th St","bus":"Bx33, M1, M10, M100, M101, M102, M104, M11, M125, M2, M3, M60-SBS, M7","shared_building":"1","neighborhood":null,"latitude":40.815,"longitude":-73.9455,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.845],"n":[119.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.894,0.887,0.888,0.817,0.857,0.852,0.858],"n":[258.0,257.0,222.0,219.0,201.0,216.0,199.0],"c":[null,null,null,null,null,0.87,0.867]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.901],"n":[221.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.586,0.581,0.628,0.549,0.552,0.532,0.263,0.372,0.371,0.434],"n":[295.0,296.0,282.0,255.0,239.0,220.0,209.0,188.0,210.0,189.0],"c":[0.635,0.57,0.578,0.599,null,null,null,0.539,0.569,0.588],"s":[1.94,1.89,3.56,1.99,null,null,null,1.92,1.36,1.66],"b":["low","low","above","low",null,null,null,"low","low","low"]},"chronic_absent_ems_allea":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[null,null,null,null,null,null,null],"st":["suppressed","suppressed","suppressed","suppressed","suppressed","suppressed","suppressed"],"n":[2.0,1.0,1.0,1.0,2.0,4.0,3.0]},"chronic_absent_ems_alleb":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.565,0.563,0.482,0.315,0.383,0.372,0.458],"n":[161.0,135.0,110.0,108.0,115.0,113.0,83.0],"c":[0.6,null,null,null,null,null,null]},"chronic_absent_ems_alleh":{"y":["2018-1