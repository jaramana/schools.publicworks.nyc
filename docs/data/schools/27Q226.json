{"school":{"dbn":"27Q226","name":"J.H.S. 226 Virgil I. Grissom","boro":"Queens","district":"27","district_label":"District 27","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":830,"enrollment_year":"2024-25","address":"121-10 ROCKAWAY BOULEVARD, QUEENS, NY 11420","phone":"718-848-9247","website":"https://www.virgilgrissom.com/","directory_url":"https://www.myschools.nyc/en/schools/middle-school/71287","accessibility":"Fully Accessible","overview":"JHS 226 Virgil I. Grissom is a learning community that focuses on the academic, social, and emotional growth of all students. The school is organized into three learning communities. Sixth grade students join our community as members of the Discovery and Explorations Academy. Students in 7th and 8th grade are members of the Humanities Academy and Renaissance Academy, respectively. Students at each grade level participate in rigorous, hands-on learning experiences that provide them with opportunities to explore new content, make connections to real-world situations, and develop arguments to support new ideas.   A well-rounded education is the cornerstone of our academic program, and students participate in a variety of elective courses. These include visual arts, dance, band, technology, health, and Virtual Enterprise Junior Venture in which students develop a virtual business. All students take part in an advisory class, which supports students\u00c3\u0083\u00c2\u00a2\u00c3\u0082\u00c2\u0080\u00c3\u0082\u00c2\u0099 social-emotional growth. Advanced Regents Program (ARP/Honors) classes are offered, and Regents exams in Algebra, Living Environment, and World Languages are administered to students in these classes.  We host a variety of extracurricular activities, which are refined each year based on the interests of our current students. In the past, these have included sports programs, academic support and enrichment classes, art club, a dance partnership with Alvin Ailey, band, and E-Sports. Students also have an opportunity to sign-up for after-school programs through Beacon or Opus Theatre and Dance. These organizations offer additional program options, including karate, aviation, cooking, and tutoring.","start_time":"08:10am","end_time":"02:29pm","languages":null,"subway":null,"bus":"Q10, Q37, Q7, Q9, QM18","shared_building":"0","neighborhood":"South Ozone Park","latitude":40.675065,"longitude":-73.816705,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.918],"st":["ok"],"n":[308.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.918,0.92,0.874,0.873,0.895,0.886,0.891],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[1027.0,1011.0,907.0,1007.0,930.0,984.0,998.0],"c":[null,null,null,null,null,1.0,0.842]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.87],"st":["ok"],"n":[896.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.837,0.765,0.732,0.709,0.72,0.627,0.512,0.591,0.555,0.605],"st":["ok","ok","ok","ok","ok","ok","ok","ok","ok","ok"],"n":[964.0,961.0,990.0,976.0,950.0,887.0,936.0,882.0,863.0,907.0],"c":[0.822,0.801,0.769,0.769,null,null,null,0.664,0.815,0.642],"s":[4.1,1.99,1.92,2.18,null,null,null,2.43,1.66,1.0]},"chronic_absent_ems_allea":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.739,0.753,0.674,0.595,0.622,0.67,0.665],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[314.0,275.0,239.0,242.0,217.0,185.0,203.0],"c":[0.8,null,null,null,null,null,null]},"chronic_absent_ems_alleb":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.707,0.692,0.581,0.474,0.59,0.527,0.604],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[335.0,318.0,272.0,270.0,273.0,243.0,245.0],"c":[0.744,null,null,null,null,null,null]},"chronic_ab