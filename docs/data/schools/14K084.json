{"school":{"dbn":"14K084","name":"P.S. 084 Jose De Diego","boro":"Brooklyn","district":"14","district_label":"District 14","report_type":"EMS","report_types":"EMS","school_type":"K-8","grades":"K to 8","status":"open","enrollment":636,"enrollment_year":"2024-25","address":"250 BERRY STREET, Brooklyn, NY 11249","phone":"718-782-2527","website":"https://www.ps84k.org/","directory_url":"https://www.myschools.nyc/en/schools/middle-school/70219","accessibility":"Partially Accessible","overview":"At P.S. 84, students become lifelong learners. Our diverse, child-centered environment fosters self-confidence and mutual respect. Using the RULER approach, we work closely with parents and with Williamsburg's talented community to nurture the social, emotional, and educational lives of all students. We strive to integrate skills that are essential to effective teaching and learning, sound decision making, physical and mental health, and success in school and beyond. As a Leader in Me school, the students are engaged in 21st century leadership and life skills to create a culture of student empowerment based on the idea that every child can be a leader. Our 1,500-square foot hydroponic rooftop greenhouse laboratory provides students with opportunities for hands-on learning and problem solving in real-world scenarios while enhancing our STEAM curriculum (Science, Technology, Engineering, Art, and Mathematics).","start_time":"08:19am","end_time":"02:39pm","languages":"Spanish","subway":"L to Bedford Av","bus":"B24, B32, B39, B44, B44-SBS, B46, B60, B62, Q54, Q59","shared_building":"0","neighborhood":"Williamsburg","latitude":40.7149,"longitude":-73.9637,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.931],"n":[352.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.927,0.927,0.906,0.89,0.9,0.91,0.908],"n":[749.0,702.0,682.0,624.0,600.0,6