{"school":{"dbn":"09X303","name":"I.S. X303 Leadership & Community Service","boro":"Bronx","district":"09","district_label":"District 9","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":295,"enrollment_year":"2024-25","address":"1700 MACOMBS ROAD, BRONX, NY 10453","phone":"(718)583-1736","website":null,"directory_url":"https://www.myschools.nyc/en/schools/middle-school/69277","accessibility":"Fully Accessible","overview":"At CIS 303, we will strive to provide a safe environment where all members of the community will be held accountable for the success of each member through efficient structures and clear expectations. We provide learning experiences which develop the learner's passion for the awareness of his or her own learning - we do this through large structures like our Advisory Program, Social Emotional Learning, Anti-Bullying/Isolation, and Digital Citizenship lessons, and with presentations from community-based organizations (like Sandy Hook Promise). We have chosen to enter candidacy to become an International Baccalaureate school to ensure our students will not only have the rigorous education to be high school / college and career ready, but globally minded to accept and attract opportunities wherever they chose. We will utilize this passion for learning and educate the whole person by providing a wide variety of academic challenges (remedial or extension) and expose the student to diverse, non-academic activities: Culture Day, Career Day, Leadership Day, participation in plays through Disney Jr., clubs / after schools, and regular field trips showing students that New York City, not just the four walls of our building, can be their classroom. We improve staff practice and student performance through consistent reflection, feedback and evaluation meeting weekly on Wednesday afternoons for extended professional development. Finally, 303 creates an accessible learning environment where effort is recognized and celebrated as well as achievement, and members are encouraged to do their best.","start_time":"08:29am","end_time":"03:10pm","languages":null,"subway":"4 to 176th St; B, D to 174-175th Sts","bus":"Bx1, Bx18A, Bx18B, Bx2, Bx3, Bx32, Bx36, Bx40, Bx42, BxM4","shared_building":"1","neighborhood":"Morris Heights","latitude":40.849464,"longitude":-73.915672,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.931],"st":["ok"],"n":[111.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.931,0.934,0.944,0.866,0.902,0.925,0.918],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[327.0,332.0,335.0,347.0,348.0,332.0,318.0],"c":[null,null,null,null,null,1.0,0.881]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.945],"st":["ok"],"n":[335.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.761,0.764,0.765,0.78,0.779,0.842,0.5,0.662,0.766,0.755],"st":["ok","ok","ok","ok","ok","ok","ok","ok","ok","ok"],"n":[326.0,331.0,344.0,322.0,321.0,330.0,330.0,337.0,329.0,306.0],"c":[0.703,0.694,0.651,0.673,null,null,null,0.636,0.818,0.65],"s":[4.21,3.75,4.25,4.83,null,null,null,3.02,4.88,4.99]},"chronic_absent_ems_allea":{"y":["2018-19","2019-20","2020-21","2022-23","2023-24","2024-25"],"v":[null,null,null,null,null,null],"st":["suppressed","suppressed","suppressed","suppressed","suppressed","suppressed"],"n":[4.0,2.0,2.0,1.0,1.0,1.0]},"chronic_absent_ems_alleb":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.805,0.8,0.83,0.5,0.678,0.778,0.75],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[87.0,90.0,100.0,94.0,90.0,81.0,64.0],"c":[0.649,null,null,null,null,null,null]},"chronic_absent_ems_alleh":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.779,0.78,0.844,0.493,0.657,0.767,0.