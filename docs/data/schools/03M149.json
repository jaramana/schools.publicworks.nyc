{"school":{"dbn":"03M149","name":"P.S. 149 Sojourner Truth","boro":"Manhattan","district":"03","district_label":"District 3","report_type":"EMS","report_types":"EMS","school_type":"K-8","grades":"K to 8","status":"open","enrollment":255,"enrollment_year":"2024-25","address":"41 West 117 Street, Manhattan, NY 10026","phone":"347-478-5228","website":"www.sotru.org","directory_url":"https://www.myschools.nyc/en/schools/middle-school/63257","accessibility":"Partially Accessible","overview":"Welcome to PS/MS149 Sojourner Truth grades 3K to 8th. Respectfully known as Sotru, the school where, \u00c3\u00a2\u00c2\u0080\u00c2\u009cLeaders are Created to Change the World.\u00c3\u00a2\u00c2\u0080\u00c2\u009d Here at Sotru you will find staff that are devoted to making an impactful change in the lives of students and their families. A place where lessons and instruction go beyond the classroom to build on everyday experiences as it prepares students for a successful future. Our students are given the opportunity to engage in rigorous academics which enhances discourse and critical thinking. In addition to a strong academic framework, students are exposed to geographic areas outside of New York City. Students take annual trips to Washington D.C., the nation's capital, where they explore national monuments and museums. They venture out of the city to upstate New York, where they learn firsthand the sport of snowboarding and skiing.  To ensure success for our students and families we have partnered up with HCZ (Harlem Children\u00c3\u00a2\u00c2\u0080\u00c2\u0099s Zone) after school program. HCZ offers services that are aligned with our vision of creating future leaders. While taking part in the after-school program students participate in the art of dancing, conduct science fairs, learn exciting activities such as skateboarding, lacrosse, year-round basketball camp and much more.  Here at Sotru we also believe in the importance of social emotional health. Therefore, we have partnered up with the New York Foundling Mental Health Clinic. As a result of the partnership, New York Foundling has set up daily services in the school building to support the mental health of our school community. In addition to caring for students, we also support the needs of the families.  Our community partnerships have allowed us to establish a school store, a care closet as well as a laundry room.  As a community school we also supply students with school supplies and uniforms.  Here at  PS/MS.149, students learn what it takes to become contributing members of society. With the support from the community and staff, our vision of creating future leaders is possible.","start_time":"08:19am","end_time":"02:39pm","languages":null,"subway":"2, 3 to 116th St","bus":"BxM2, BxM3, BxM4, M1, M10, M101, M102, M103, M116, M125, M2, M3, M4, M60-SBS, M7, M98","shared_building":"0","neighborhood":"Harlem","latitude":40.802671,"longitude":-73.948127,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.805],"st":["ok"],"n":[89.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.943,0.931,0.87,0.84,0.87,0.865,0.871],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[230.0,233.0,216.0,265.0,276.0,305.0,267.0],"c":[null,null,null,null,null,0.93,0.861]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.89],"st":["ok"],"n":[212.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.7,0.625,0.722,0.85,0.741,0.555,0.35,0.519,0.436,0.479],"st":["ok","ok","ok","ok","ok","ok","ok","ok","ok","ok"],"n":[267.0,256.0,237.0,227.0,220.0,209.0,257.0,260.0,291.0,263.0],"c":[0.61,0.594,0.641,0.655,null,null,null,0.575,0.631,0.573],"s":[4.0,3.33,4.9,4.99,null,null,null,2.23,1.79,1.09],"b":["high","above","high","high",null,null,null,"below","low","low"]},"chronic_absent_ems_al