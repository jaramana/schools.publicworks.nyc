{"school":{"dbn":"09X128","name":"Mott Hall III","boro":"Bronx","district":"09","district_label":"District 9","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":278,"enrollment_year":"2024-25","address":"580 CROTONA PARK SOUTH, BRONX, NY 10456","phone":"718-590-5455","website":"www.MottHall3.com","directory_url":"https://www.myschools.nyc/en/schools/middle-school/63496","accessibility":"Not Accessible","overview":"Our students enjoy our small environment where they are treated like family and pushed to be their very best. We celebrate our students' talents through curriculum fairs, talent showcases, and cultural celebrations. We take multiple college trips each year in and around the NYC area, and our College and Career Days launch our students in planning their futures. During weekly talent periods, students can explore an interest or talent of their choice, and after school, we offer art club, multiple sports, and musical theater. We have SMART Boards and computers in each classroom and a state-of-the-art computer lab where students use technology to collaborate, learn, and create. Parents embrace our challenging academic experiences and high standards. We offer families tools to support their children, including weekly progress reports and an online gradebook, and we work with every student to ensure that they meet performance standards. Our school is proud to have proficiency scores in ELA and math that exceed district averages, and students have an opportunity to take Regents-level courses and receive high school credit before they graduate middle school. We were listed as \"Among the Best\" middle schools by the NY Daily News in 2012, and we have been profiled in each edition of New York City's Best Public Middle Schools: A Parent's Guide. MH3 is proud to be a Competency Collaborative member school and an International Baccalaureate candidate school. Our graduates regularly gain acceptance into highly competitive specialized, private, and parochial high schools.","start_time":"08:15am","end_time":"02:35pm","languages":null,"subway":null,"bus":"Bx11, Bx15, Bx17, Bx21, Bx35, Bx41, Bx41-SBS","shared_building":"1","neighborhood":"South Bronx","latitude":40.835042,"longitude":-73.900555,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.987],"st":["ok"],"n":[127.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.937,0.957,0.943,0.908,0.9,0.881,0.878],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[360.0,349.0,360.0,339.0,326.0,323.0,304.0],"c":[null,null,null,null,null,1.0,0.879]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.94],"st":["ok"],"n":[359.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.858,0.847,0.883,0.817,0.886,0.821,0.673,0.653,0.557,0.52],"st":["ok","ok","ok","ok","ok","ok","ok","ok","ok","ok"],"n":[374.0,360.0,366.0,355.0,343.0,357.0,333.0,317.0,316.0,294.0],"c":[0.8,0.769,0.75,0.752,null,null,null,0.677,0.837,0.632],"s":[4.25,3.51,4.7,4.01,null,null,null,2.73,1.56,1.0],"b":["high","above","high","high",null,null,null,"below","low","low"]},"chronic_absent_ems_allea":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24"],"v":[null,null,null,null,null,null],"st":["suppressed","suppressed","suppressed","suppressed","suppressed","suppressed"],"n":[3.0,3.0,2.0,1.0,2.0,3.0]},"chronic_absent_ems_alleb":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.871,0.938,0.828,0.718,0.644,0.546,0.486],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[116.0,113.0,116.0,117.0,118.0,119.0,107.0],"c":[0.753,null,null,null,null,null,null]},"chronic_absent_ems_alleh":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.799,0.858,0.817,0.658,0.67,0.564,0.538],"