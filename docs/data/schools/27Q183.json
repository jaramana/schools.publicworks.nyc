{"school":{"dbn":"27Q183","name":"P.S. 183 Dr. Richard R. Green","boro":"Queens","district":"27","district_label":"District 27","report_type":"EMS","report_types":"EMS","school_type":"K-8","grades":"K to 8","status":"open","enrollment":409,"enrollment_year":"2024-25","address":"2-45 BEACH 79 STREET, Queens, NY 11693","phone":"718-848-0001","website":"www.psms183q.org","directory_url":"https://www.myschools.nyc/en/schools/middle-school/70667","accessibility":"Partially Accessible","overview":"Our school community is characterized by our service to our children in Grades 3K-8. The student body under the auspices of the Student Government, was surveyed and collectively decided on a H.U.S.K.Y. mascot that emulates teamwork and an acronym that spells out \"Honesty, Understanding, Self-Control, Kindness, You are a Leader.\" The student affirmation reads: \"I am a leader. First, I think. Then, I will tell show or write. 183 is the place to be!\" Parent/guardians are recognized as the child's 1st teacher and essential allies in how we value our children. Our diverse student demographic data comprises of 420+ students. Administration, teachers, paraprofessionals, service providers, parents, students, and partners, are dedicated to the mission of each child \"developing as a reader\" that finds joy in living as a literate being. We thrive using the HMH Into Reading literacy program and the Math EnVisions 2,0 program in grades K-8. We offer opportunities such as the Gifted & Talented curriculum in Grades 3,4, and 5. Most of our teachers are trained in how to teach reading through the LETRS certification process. We are an accredited Thinking Maps school. The Thinking Map initiative with the use of the 8 tools to visualize thinking, is a core support through the curriculum, instruction, assessment, management, organizational culture, and leadership. Across grades 3K-8 our students have access to high-speed internet, iPads, and Chromebooks for use in school and at home. Each partnership in our school gives our students opportunities to become lifelong learners, creators, and problem solvers. We flourish through an active community approach highlighting multiple grants, a clothing pantry, plentiful supplies for learners, and a HUSKY culture. We are committed to enrichment activities and family supports through a viable partnership with the Department of Youth and Community Development and provide after school programs for grades K-8.","start_time":"08:00am","end_time":"02:19pm","languages":null,"subway":"A to Beach 67th St; H to Beach 90th St","bus":"Q22, Q52-SBS, QM17","shared_building":"0","neighborhood":"Rockaway Beach","latitude":40.7407,"longitude":-73.8853,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.806],"n":[170.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.882,0.888,0.808,0.805,0.827,0.835,0.845],"n":[483.0,468.0,460.0,463.0,458.0,461.0,466.0],"c":[null,null,null,null,null,0.914,0.861]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.81],"n":[457.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.562,0.541,0.561,0.488,0.544,0.356,0.284,0.336,0.361,0.434],"n":[617.0,593.0,549.0,475.0,441.0,438.0,444.0,435.0,438.0,445.0],"c":[0.626,0.597,0.547,0.57,null,null,null,0.46,0.617,0.571],"s":[2.14,1.45,2.2,1.52,null,null,null,1.49,1.47,1.0],"b":["below","low","below","low",null,null,null,"low","low","low"]},"chronic_absent_ems_allea":{"y":["2018-19","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.813,0.625,0.48,0.476,0.381,0.682],"n":[16.0,16.0,25.0,21.0,21.0,22.0],"c":[0.663,null,null,null,null,null]},"chronic_absent_ems_alleb":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.471,0.553,0.292,0.29,0.391,0.375,0.413],"n":[291.0,266.0,253.0,255.0,238.