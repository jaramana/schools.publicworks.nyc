{"school":{"dbn":"19K760","name":"Highland Park Community School","boro":"Brooklyn","district":"19","district_label":"District 19","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":219,"enrollment_year":"2024-25","address":"528 RIDGEWOOD AVENUE, BROOKLYN, NY 11208","phone":"929-397-2967","website":"www.highlandparkschool.org","directory_url":"https://www.myschools.nyc/en/schools/middle-school/71879","accessibility":"Not Accessible","overview":"HPCS is a collaborative school in which students, parents, and teachers work together to improve the learning outcomes and opportunities available to students. At HPCS, we pride ourselves on ensuring that students are active participants in their educational journey. As a school, we expose students to rigorous instruction and various stem opportunities that would  prepare them to become empowered leaders that will thrive in the 21st Century. Students are offered the opportunity to participate in advance regents courses. We ensure equity for all by attending to the individualized student needs so that all students will achieve academic success. Students receive instruction that is culturally relevant, rigorous, and includes opportunities to problem solve, collaborate with their peers, and clearly communicate their thinking. We are a  VILS School which means that students have access to technology to advance their learning and teachers are provided with training on technological supports that can be used to increase student engagement and enhance learning experiences. Students benefit from this program because it provides them with easy access to information, it accelerates their learning, attend to their varied learning styles, and provide fun ways for students to practice what they are learning. The over-arching goal of HPCS is to empower students to be leaders and bold thinkers that are prepared to be successful in the careers of the future. We work to restore the love for school, having kids enjoy learning, feel supported, and advocate for activities of their interests.","start_time":"08:00am","end_time":"02:19pm","languages":null,"subway":"J, Z to Crescent St","bus":"B13, Q24, Q56","shared_building":"1","neighborhood":"East New York","latitude":40.6859,"longitude":-73.8694,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.91],"n":[135.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.915,0.925,0.906,0.903,0.912,0.921,0.912],"n":[355.0,392.0,379.0,332.0,287.0,260.0,238.0],"c":[null,null,null,null,null,1.0,0.9]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.907],"n":[378.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.731,0.63,0.673,0.709,0.78,0.704,0.682,0.673,0.736,0.736],"n":[212.0,311.0,336.0,351.0,368.0,362.0,305.0,281.0,254.0,235.0],"c":[0.798,0.784,0.752,0.794,null,null,null,0.669,0.88,0.697],"s":[2.32,1.0,1.41,1.98,null,null,null,2.89,4.85,4.99],"b":["below","low","low","low",null,null,null,"below","high","high"]},"chronic_absent_ems_alleb":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.722,0.769,0.6,0.565,0.52,0.56,0.55],"n":[54.0,39.0,30.0,23.0,25.0,25.0,20.0],"c":[0.763,null,null,null,null,null,null]},"chronic_absent_ems_alleh":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.691,0.773,0.705,0.693,0.684,0.767,0.764],"n":[269.0,300.0,298.0,244.0,231.0,206.0,195.0],"c":[0.795,null,null,null,null,null,null]},"chronic_absent_ems_allei":{"y":["2021-22"],"v":[null],"st":["suppressed"],"n":[4.0]},"chronic_absent_ems_allem":{"y":["2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[null,null,null,null,null,null],"st":["suppressed","suppressed","suppressed","suppressed","suppressed","suppressed"],"