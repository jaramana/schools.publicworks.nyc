{"school":{"dbn":"01M364","name":"Earth School","boro":"Manhattan","district":"01","district_label":"District 1","report_type":"EMS","report_types":"EMS","school_type":"Elementary","grades":"PK-5","status":"open","enrollment":176,"enrollment_year":"2024-25","address":"600 EAST 6 STREET, MANHATTAN, NY 10009","phone":"212-477-1735","website":"WWW.THEEARTHSCHOOL.ORG","directory_url":"https://www.myschools.nyc/en/schools/kindergarten/66261","accessibility":"Not Accessible","overview":"In 1992, teachers in Manhattan\u00c3\u0083\u00c2\u00a2\u00c3\u0082\u00c2\u0080\u00c3\u0082\u00c2\u0099s East Village founded the Earth School on a dream: to create a peaceful, nurturing place to stimulate learning in all areas of child development-- intellectual, social, emotional, artistic, and physical. Today it is a vibrant community of pre-kindergarten through 5th grade Earthlings, with a teaching staff dedicated to the founding values of hands-on exploration, an arts-rich curriculum, responsible stewardship of the Earth\u00c3\u0083\u00c2\u00a2\u00c3\u0082\u00c2\u0080\u00c3\u0082\u00c2\u0099s resources, harmonious resolution of conflict, and parent-teacher partnership.\n\nEarth School teachers believe in a \"child-centered\" approach that considers children's individual experiences, identities, and relationships to be essential factors in knowing how best to support their learning and growth. While engaging in rich learning experiences in the academic content areas, our Earthlings are encouraged to explore, experiment, and even sometimes make a mess in the pursuit of learning. From PreK to 5th grade, children engage in countless field trips, ranging from walking trips to visit the many cultural resources in our own neighborhood, to overnight trips in our upper grades to engage in extended learning experiences in outdoor education. \n\nEarth School families come from diverse cultural, ethnic and economic backgrounds, and our school emphasizes community building and inclusivity--differences are celebrated as key to the richness of our school, city, and world communities.  \n\nNotes: \nWe offer an on-site after school option for PreK-5th grade families, and coordinate with neighborhood afterschool providers for a variety of after school programs that serve K-5th grade students. \n\nEnrollment in a public elementary does not guarantee school bus service. For more information please visit schools.nyc.gov/BusEligibility.\n\nPriority is given to applicants living in temporary housing, who are English Language Learners, and/or eligible for Free and Reduced Lunch (based on family income) for a percentage of seats based on the applicant pool. Students who do not fall into any of these groups will get a priority for the remaining percentage of offers.","start_time":"8:30 AM","end_time":"2:50 PM","languages":null,"subway":"F to 2nd Av; J, M, Z to Essex St","bus":"B39, M14A-SBS, M14D-SBS, M15, M15-SBS, M21, M8, M9","shared_building":"1","neighborhood":null,"latitude":40.724152,"longitude":-73.981603,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.917],"st":["ok"],"n":[113.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.931,0.923,0.935,0.895,0.892,0.903,0.914],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[322.0,328.0,278.0,225.0,205.0,184.0,167.0],"c":[null,null,null,null,null,0.895,0.901]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.938],"st":["ok"],"n":[276.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.824,0.814,0.777,0.787,0.717,0.779,0.602,0.527,0.676,0.665],"st":["ok","ok","ok","ok","ok","ok","ok","ok","ok","ok"],"n":[306.0,301.0,327.0,319.0,322.0,272.0,221.0,203.0,182.0,167.0],"c":[0.845,0.796,0.784,0.768,null,null,null,0.631,0.675,0.691],"s":[2.9,2.16,2.72,3.09,null,null,null,2.4,3.04,2.79]},"chronic_