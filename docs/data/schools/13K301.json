{"school":{"dbn":"13K301","name":"Restoration Academy Magnet School of Global Exploration and Innovation","boro":"Brooklyn","district":"13","district_label":"District 13","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":94,"enrollment_year":"2024-25","address":"31 NEW YORK AVENUE, BROOKLYN, NY 11216","phone":"7187807660","website":"Restorationacademymagnetschool.org","directory_url":"https://www.myschools.nyc/en/schools/middle-school/65783","accessibility":"Not Accessible","overview":"Restoration Academy, Magnet School of Global Exploration and Innovation, is an International Baccalaureate (IB) candidate school. Located on the border of Crown Heights and Bedford Stuyvesant, we are a non-zoned school and welcome students from all boroughs. Our Mission is to empower FUTURE Leaders. Our goal is to create a culture of self-directed, responsible, free thinkers who respect themselves and others, with an appreciation for diversity, cultural understanding, community and global engagement. We use an interdisciplinary, project-based approach that utilizes technology in teaching and learning to expose students to the interconnectedness of our world and prepare them to take their place as global citizens and leaders. Students explore the world around them through activities that promote the acquisition of 21st-century skills such as critical thinking, collaboration, creativity, and communication. We emphasize student voice and choice, and foster the development of the social-emotional and academic skills needed to be successful in today's world.","start_time":"08:00am","end_time":"02:19pm","languages":null,"subway":"A, C to Nostrand Av","bus":"B15, B25, B26, B43, B44, B44-SBS, B48, B49, B65","shared_building":"1","neighborhood":"Bedford Stuyvesant","latitude":40.678914,"longitude":-73.946501,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020