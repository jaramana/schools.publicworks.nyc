{"school":{"dbn":"14K582","name":"M.S. 582","boro":"Brooklyn","district":"14","district_label":"District 14","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":335,"enrollment_year":"2024-25","address":"207 BUSHWICK AVENUE, BROOKLYN, NY 11206","phone":"7187820918","website":"www.magnet582.com","directory_url":"https://www.myschools.nyc/en/schools/middle-school/66969","accessibility":"Not Accessible","overview":"M.S. 582, located in East Williamsburg, New York, is The Magnet School for Multimedia Technology and Urban Planning, serving students from grades 6 to 8. Our educational philosophy is grounded in experience, exposure, and discovery, and we are dedicated to creating opportunities for our students to engage in these areas meaningfully.  Beyond our robust core curriculum, M.S. 582 offers a variety of specialized programs, including technology, hydroponics, music, and art. Our extracurricular activities are designed to foster diverse interests and skills, featuring options such as debate, chess, crochet, robotics, and fabrication. We take pride in our state-of-the-art fabrication lab, equipped with advanced tools like 3-D printers, engravers, and laser cutters.  Our eighth-grade students have the opportunity to challenge themselves with advanced courses, including Algebra One Regents, Living Environment Regents, and History Regents. In addition, we provide a comprehensive seasonal sports program, which includes baseball, softball, flag football, basketball, volleyball, track, wrestling, soccer, and cheerleading.  M.S. 582 values community engagement and partnership. We collaborate closely with Grand Street Settlement, which supports our five-day afterschool program, ensuring that our students receive enriching experiences beyond the classroom.  M.S. 582 is proud to be a Community School. Through our partnership with Grand Street Settlement, we provide a wealth of resources that extend beyond traditional academics. This collaboration equips our school with dedicated school counselors, family support services, and assistance in social and emotional learning. These resources ensure that our students and their families receive comprehensive support, fostering a nurturing and inclusive environment.  Students should choose M.S. 582 because we offer a unique blend of rigorous academics, innovative programs, and extensive extracurricular activities, all within a supportive community framework. Our commitment to experiential learning, coupled with our state-of-the-art facilities and strong community partnerships, prepares students for success in high school and beyond. Join us at M.S. 582, where education is an adventure in experience, exposure, and discovery.","start_time":"08:00am","end_time":"02:19pm","languages":null,"subway":"L to Montrose Av","bus":"B24, B43, B48, B57, B60, Q54, Q59","shared_building":"1","neighborhood":"Williamsburg","latitude":40.7086,"longitude":-73.9395,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.852],"n":[172.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.907,0.925,0.873,0.878,0.891,0.887,0.88],"n":[313.0,345.0,359.0,356.0,337.0,336.0,353.0],"c":[null,null,null,null,null,1.0,0.879]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.876],"n":[359.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.711,0.771,0.709,0.629,0.729,0.588,0.545,0.572,0.56,0.542],"n":[253.0,271.0,278.0,313.0,339.0,354.0,341.0,332.0,332.0,347.0],"c":[0.72,0.688,0.676,0.674,null,null,null,0.618,0.784,0.612],"s":[3.71,3.58,3.34,2.32,null,null,null,2.57,1.84,1.0],"b":["above","above","above","below",null,null,null,"below","low","low"]},"chronic_absent_ems_allea":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024