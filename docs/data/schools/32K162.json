{"school":{"dbn":"32K162","name":"J.H.S. 162 The Willoughby","boro":"Brooklyn","district":"32","district_label":"District 32","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":283,"enrollment_year":"2024-25","address":"1390 WILLOUGHBY AVENUE, BROOKLYN, NY 11237","phone":"718-574-0361","website":null,"directory_url":"https://www.myschools.nyc/en/schools/middle-school/67080","accessibility":"Partially Accessible","overview":"Welcome to IS 162: Teaching the Will-to-Be Excellent At IS 162, we believe in the power of education to transform lives and shape a better future. Nestled in the vibrant neighborhood of Bushwick, New York, our middle school is a place where students can thrive academically, socially, and emotionally. With a strong emphasis on academic excellence, character development, and community engagement, we provide a nurturing environment where students can explore their interests, cultivate their talents, and prepare for success in high school and beyond. Academic Excellence: Unlocking Potential At IS 162, we are committed to providing a rigorous and comprehensive academic program that prepares our students for the challenges of high school and equips them with the skills necessary for lifelong learning. Our dedicated and highly qualified faculty members foster a stimulating learning environment where critical thinking, problem-solving, and creativity are nurtured. Through a combination of engaging classroom instruction, hands-on projects, and technology integration, students develop a deep understanding of core subjects such as mathematics, language arts, science, and social studies. We also offer a variety of elective courses, including visual and performing arts, foreign languages, and computer science, allowing students to explore their passions and broaden their horizons. Character Development: Empowering Leaders At IS 162, we recognize the importance of character development and strive to instill values such as respect, responsibility, integrity, and compassion in our students. Our comprehensive SEL program promotes social-emotional learning, fostering self-awareness, empathy, and effective communication skills. Through various leadership opportunities, including student leadership, community service projects, and extracurricular clubs, students learn to take initiative, collaborate with others, and make a positive impact in their community. We believe that by nurturing the whole child, we empower our students to become confident, compassionate, and responsible individuals. Community Engagement: Connecting Beyond the Classroom At IS 162, we understand the significance of community and actively engage our students in meaningful experiences beyond the classroom. Our partnerships with local organizations and businesses provide students with real-world connections. We encourage family involvement through parent workshops, volunteering, and special events, fostering a strong sense of belonging and support. Our vibrant multicultural community celebrates diversity and promotes understanding, ensuring that all students feel valued and respected. State-of-the-Art Facilities: Inspiring Learning Environments Equipped with modern classrooms, science laboratories, makerspaces, and a thriving hydroponics grow lab students have access to resources that support their academic pursuits and artistic expression. We prioritize creating a safe and welcoming environment where students can thrive and reach their full potential. Preparing for the Future: High School Readiness At IS 162, we are dedicated to preparing our students for success in high school and beyond. Our comprehensive college and career readiness program equips students with the skills and knowledge necessary for their future endeavors. Through guidance and support from our counseling department, students explore post-secondary options, develop a personalized plan, and receive assistance with the high school application process. We are proud of our track record of graduates who go on to excel in  high school, colleges, and careers.","start_time":"08:29am","end_time":"02:50pm","languages":null,"subway":"L to Jefferson St","bus":"B13, B38, B57, Q54","shared_building":"0","neighborhood":"Bushwick","latitude":40.7067,"longitude":-73.9197,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.965],"n":[182.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.924,0.929,0.936,0.94,0.936,0.935,0.928],"n":[353.0,335.0,353.0,340.0,322.0,342.0,311.0],"c":[null,null,null,null,null,1.0,0.894]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.93],"n":[348.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.748,0.701,0.682,0.742,0.785,0.825,0.829,0.811,0.8,0.744],"n":[485.0,438.0,380.0,349.0,325.0,343.0,321.0,318.0,330.0,305.0],"c":[0.736,0.721,0.697,0.737,null,null,null,0.71,0.877,0.689],"s":[3.98,2.31,2.38,3.38,null,null,null,3.52,4.87,4.99],"b":["above","below","below","above",null,null,null,"above","high","high"]},"chronic_absent_ems_allea":{"y":["2023-24"],"v":[null],"st":["suppressed"],"n":[4.0]},"chronic_absent_ems_alleb":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.467,0.722,0.643,0.667,0.529,0.684,0.7],"n":[15.0,18.0,28.0,21.0,17.0,19.0,20.0],"c":[0.687,null,null,null,null,null,null]},"chronic_absent_ems_alleh":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.752,0.781,0.838,0.848,0.824,0.8,0.743],"n":[311.0,288.0,290.0,276.0,279.0,295.0,265.0],"c":[0.736,null,null,null,null,null,null]},"chronic_absent_ems_allei":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[null,null,null,null,null,null,null],"st":["suppressed","suppressed","suppressed",