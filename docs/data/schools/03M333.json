{"school":{"dbn":"03M333","name":"P.S. 333 Manhattan School for Children","boro":"Manhattan","district":"03","district_label":"District 3","report_type":"EMS","report_types":"EMS","school_type":"K-8","grades":"K to 8","status":"open","enrollment":448,"enrollment_year":"2024-25","address":"154 WEST 93 STREET, MANHATTAN, NY 10025","phone":"212-595-7193","website":"www.ps333.org","directory_url":"https://www.myschools.nyc/en/schools/middle-school/70177","accessibility":"Fully Accessible","overview":"Our mission is to be a caring community of lifelong learners, with collaborative teaching in a workshop model where you the students are doing most of the talking and heavy lifting of your own learning. Teachers are facilitators and coaches. Our student-centered, pedagogical focus and instructional program is unique and grounded in the philosophy of a \"community of learners.\"  We believe that all children are gifted in multiple ways: Children learn by doing Children learn at different rates, using different strengths and different learning styles Children learn about the world in an integrated way Children learn when they feel good about themselves Children learn when their families are active participants in their school Students engage daily in challenging work that requires you to think, reflect and problem solve. We value questioning that leads to discussion, as well as routines that provide all students access to the curricula, extends your higher order thinking skills, and promotes rigor and ownership of their learning. Your teachers and I look forward to this school year which promises to be an exciting, enriching and full of learning.","start_time":"8:32am","end_time":"2:52pm","languages":null,"subway":"1, 2, 3 to 96th St","bus":"M10, M104, M106, M11, M5, M7, M86-SBS, M96","shared_building":"1","neighborhood":"Upper West Side","latitude":40.791479,"longitude":-73.970848,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attenda