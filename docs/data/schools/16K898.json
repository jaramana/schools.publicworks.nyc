{"school":{"dbn":"16K898","name":"The Brooklyn Green School","boro":"Brooklyn","district":"16","district_label":"District 16","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":218,"enrollment_year":"2024-25","address":"130 ROCHESTER AVENUE, BROOKLYN, NY 11213","phone":"718-462-6992","website":"thebrooklyngreenschool.org","directory_url":"https://www.myschools.nyc/en/schools/middle-school/64855","accessibility":"Partially Accessible","overview":"The Brooklyn Green, Magnet School for Eco-Activism, is nestled in the Historic Weeksville District of Crown Heights. Our school is a beacon of progressive education, dedicated to nurturing well-rounded scholars and eco-conscious citizens. A typical day for a BKG student is a dynamic blend of academic rigor, creative exploration, and community engagement. From Mathematics to Humanities, Advisory with Restorative Circles to Art, Coding to Guitar, Band to Yoga, and Theater to Inquiry-based Science, our curriculum is designed to ignite curiosity and cultivate holistic growth. Every year our students participate in a Broadway Jr. Performance, compete in citywide debate tournaments and athletic teams.  At BKG, every voice matters. Students actively participate in decision-making processes as integral members of the School Leadership Team, Sustainability Team, Student Ambassadors, and Student Government. We foster a deep sense of social responsibility, with a strong emphasis on community service and social justice. Physical well-being is just as important as mental growth. In addition to a comprehensive Physical Education program, students partake in various sports, both within and outside of class, promoting teamwork and healthy lifestyles. At The Brooklyn Green Magnet School, we believe in learning by doing. Our project-based approach empowers students to design, create, and present their ideas, preparing them for real-world challenges. Education extends beyond the classroom walls; the vibrant tapestry of New York City becomes our campus, with frequent excursions within the community, throughout the city, and even beyond state lines. Diversity is our strength. Every student's background and experiences are valued, fostering an inclusive environment where everyone is celebrated as a uniquely valuable member of our school community. As a city-wide school, we welcome students from all corners of New York City, united in our pursuit of excellence and positive change.","start_time":"08:19am","end_time":"02:39pm","languages":null,"subway":"A, C to Utica Av","bus":"B14, B15, B17, B25, B45, B46, B46-SBS, B47, B65","shared_building":"1","neighborhood":null,"latitude":40.67448,"longitude":-73.928395,"coordinate_source":"geocoded","first_year":"2018-19","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.974],"st":["ok"],"n":[87.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.946,0.949,0.962,0.899,0.909,0.908,0.908],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[52.0,93.0,154.0,185.0,212.0,211.0,231.0],"c":[null,null,null,null,null,1.0,0.881]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.96],"st":["ok"],"n":[153.0]},"chronic_absent_ems_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.86,0.843,0.893,0.635,0.646,0.618,0.677],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[50.0,89.0,150.0,167.0,198.0,207.0,226.0],"c":[0.665,null,null,null,0.663,0.838,0.656],"s":[null,null,null,null,2.76,1.85,4.88]},"chronic_absent_ems_allea":{"y":["2021-22","2022-23","2023-24"],"v":[null,null,null],"st":["suppressed","suppressed","suppressed"],"n":[3.0,2.0,1.0]},"chronic_absent_ems_alleb":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.86,0.851,0.901,0.636,0.659,0.623,0.65],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[43.0,74.0,121.0,118.0,132.0,130.0,160.0],"c":[0.669,null,null,null,null