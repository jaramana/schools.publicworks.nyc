{"school":{"dbn":"18K763","name":"Brooklyn Science and Engineering Academy","boro":"Brooklyn","district":"18","district_label":"District 18","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":401,"enrollment_year":"2024-25","address":"5404 TILDEN AVENUE, BROOKLYN, NY 11203","phone":"718 927 5228","website":"https://sites.google.com/brooklynsea.org/bsea-2020/home","directory_url":"https://www.myschools.nyc/en/schools/middle-school/66340","accessibility":"Fully Accessible","overview":"The Brooklyn Science and Engineering Academy (BSEA) promotes a family-like environment with small class sizes, open communication with families and interest based crews. We foster opportunities within STEAM (Science, Technology, Engineering, Art, and Math) education. Students' school hours are 8:00am - 2:51pm Mondays - Thursdays. Students are dismissed at 12:50pm on Fridays. Families may register students for the after school Brienza Program that dismisses at 5:00pm each day at no cost. At BSEA, you will be exposed to coding, robotics, engineering, design, virtual/augmented reality, and the arts. Our students are NYC Junior Ambassadors and attend events to develop solutions to climate change issues with Ambassadors from the United Nations. BSEA has a technology lab as well as individual laptops in all classrooms. We offer a wide array of sports. Students participate in flag football, soccer, track, basketball, wiffle ball, and volleyball. BSEA students attend many trips such as Broadway shows, professional sporting events, cultural institutions and more.","start_time":"08:00am","end_time":"02:45pm","languages":null,"subway":null,"bus":"B17, B35, B46, B46-SBS, B47, B7, B8","shared_building":"1","neighborhood":"East Flatbush","latitude":40.647923,"longitude":-73.925401,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.955],"st":["ok"],"n":[10