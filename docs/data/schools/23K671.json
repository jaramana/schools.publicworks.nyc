{"school":{"dbn":"23K671","name":"Mott Hall Bridges Academy","boro":"Brooklyn","district":"23","district_label":"District 23","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":201,"enrollment_year":"2024-25","address":"210 CHESTER STREET, BROOKLYN, NY 11212","phone":"718-205-6788","website":"https://www.mhbabrooklyn.com/","directory_url":"https://www.myschools.nyc/en/schools/middle-school/68646","accessibility":"Partially Accessible","overview":"Mott Hall Bridges Academy is a small middle school in Brownsville, Brooklyn. Currently, 200 scholars are enrolled, resulting in a close knit, family environment. Our STEAM focus prepares scholars not only to be independent, critical thinkers, but to be equipped for the challenges of the 21st century. The social emotional development of our scholars is of utmost important to us here at Mott Hall Bridges Academy. Programs such as She Is Me and IMatter are geared towards their personal development. Our Champion program ensures that each scholar has an adult who he/she can confide in or rely on for support. All scholars are assigned to one of our four Houses where the team works to instill a sense of camaraderie through friendly competition. Monthly competitions such as the Spelling Bee, Step Wars, Math Bowl, Poetry Slam and Bridges Got Talent, are some of the ways that we maintain a strong positive culture at our school. Our Be Cool Be Kind anti-bullying campaign and efforts to stamp out bullying has earned us the designation of a Respect For All School. Here at MHBA we have a niche for every scholar. Our Royal Researchers Science Club and our robust Art program allows scholars to nurture their creativity and follow their passion. Students present quarterly performances in our Community Spotlight elective classes. Our Athletic Department is also an active part of what makes our school unique. Our different sports teams include: Royal Vision Steppers, Royal Hitters Softball Team, Royal Knights Basketball (Varsity & JV) Royal Knights Football (Varsity & JV), Royal Runners Track Team, and Royal Rhythm Dance Team.","start_time":"08:00am","end_time":"02:19pm","languages":null,"subway":"3 to Rockaway Av","bus":"B12, B14, B60, B7","shared_building":"1","neighborhood":"Brownsville","latitude":40.666568,"longitude":-73.911269,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.961],"st":["ok"],"n":[72.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.909,0.918,0.913,0.87,0.848,0.842,0.837],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[208.0,223.0,212.0,211.0,206.0,149.0,243.0],"c":[null,null,null,null,null,1.0,0.84]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.911],"st":["ok"],"n":[211.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.797,0.758,0.68,0.654,0.685,0.733,0.497,0.425,0.418,0.345],"st":["ok","ok","ok","ok","ok","ok","ok","ok","ok","ok"],"n":[207.0,198.0,203.0,205.0,216.0,206.0,199.0,193.0,141.0,229.0],"c":[0.727,0.678,0.639,0.627,null,null,null,0.528,0.702,0.517],"s":[4.49,3.42,3.17,3.36,null,null,null,2.16,1.6,1.0]},"chronic_absent_ems_allea":{"y":["2018-19","2019-20","2021-22"],"v":[null,null,null],"st":["suppressed","suppressed","suppressed"],"n":[2.0,1.0,1.0]},"chronic_absent_ems_alleb":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.669,0.682,0.758,0.481,0.441,0.398,0.36],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[169.0,170.0,153.0,154.0,143.0,98.0,139.0],"c":[0.63,null,null,null,null,null,null]},"chronic_absent_ems_alleh":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.581,0.714,0.66,0.656,0.35,0.486,0.289],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[31.0,42.0,47.0,32.0,40.0,37.0,83.0],"c":[0.598,null