{"school":{"dbn":"22K245","name":"P.S. 245","boro":"Brooklyn","district":"22","district_label":"District 22","report_type":"EMS","report_types":"EMS","school_type":"Elementary","grades":"PK-5","status":"open","enrollment":227,"enrollment_year":"2024-25","address":"249 East 17 Street, Brooklyn, NY 11226","phone":"718-284-2330","website":"WWW.PS245K.ORG","directory_url":"https://www.myschools.nyc/en/schools/kindergarten/71707","accessibility":"Not Accessible","overview":"Magnet schools are public school options that provide a school-wide curriculum designed around a specific theme. They are intended to attract a diverse pool of applicants and historically have accommodated students from outside their zone or district. While some schools may have the word \"magnet\" in their school's name, only a school that currently gets Magnet Schools Assistance Program (M.S.A.P) funding is labeled as a \"magnet school\" on it's MySchools page. This magnet school offers a school-wide curriculum around the theme of Art and Science. Our mission at P.S. 245 is to provide each student with engaging learning experiences and a rigorous educational program. Our goal is to empower each student to grow intellectually and socially and to ensure that each student graduates on a pathway to a rewarding career, long-term economic security and equipped to be a positive force for change\t\t\t\n\nDue to our unique small school size, it allows us to know each child closely. Students are provided with a nurturing academic and safe learning environment. Small group instruction takes place in every classroom, every day. During this time. students are provided with tailored differentiated instruction to meet their individual needs. \n\nOur school has a full-time guidance counselor and social worker who works in collaboration with classroom teachers to provide a supportive school community for all of our students. Each student will participate in PE, art and music classes throughout the year as well several school-wide events such as our Thanksgiving Feast, Holiday shows &Spring Fling.","start_time":"8:15 AM","end_time":"2:35 PM","languages":null,"subway":"B, Q to Beverly Rd","bus":"B103, B16, B35, B41, B49, B68, BM1, BM2, BM3, BM4","shared_building":"0","neighborhood":null,"latitude":40.644983,"longitude":-73.962889,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.94],"st":["ok"],"n":[141.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.951,0.954,0.917,0.922,0.924,0.922,0.92],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[300.0,268.0,249.0,233.0,224.0,227.0,231.0],"c":[null,null,null,null,null,0.883,0.887]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.919],"st":["ok"],"n":[247.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.897,0.91,0.864,0.863,0.897,0.705,0.716,0.745,0.746,0.717],"st":["ok","ok","ok","ok","ok","ok","ok","ok","ok","ok"],"n":[301.0,299.0,317.0,299.0,261.0,244.0,232.0,216.0,224.0,223.0],"c":[0.823,0.809,0.724,0.749,null,null,null,0.623,0.638,0.647],"s":[4.19,4.99,4.99,4.99,null,null,null,3.75,4.69,4.33],"b":["high","high","high","high",null,null,null,"above","high","high"]},"chronic_absent_ems_allea":{"y":["2018-19","2021-22","2022-23","2023-24","2024-25"],"v":[null,null,null,null,null],"st":["suppressed","suppressed","suppressed","suppressed","suppressed"],"n":[4.0,3.0,3.0,3.0,3.0]},"chronic_absent_ems_alleb":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.871,0.901,0.691,0.774,0.752,0.8,0.777],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[163.0,131.0,123.0,115.0,113.0,105.0,94.0],"c":[0.751,null,null,null,null,null,null]},"chronic_absent_ems_alleh":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.863,0.894,0.725,0.657,0.709,0.684,0