{"school":{"dbn":"19K661","name":"Vista Academy","boro":"Brooklyn","district":"19","district_label":"District 19","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":436,"enrollment_year":"2024-25","address":"350 LINWOOD STREET, BROOKLYN, NY 11208","phone":"718-647-1301","website":"https://www.vistaacademybrooklyn.com/","directory_url":"https://www.myschools.nyc/en/schools/middle-school/62195","accessibility":"Partially Accessible","overview":"At Vista Academy we focus on high academic achievement and character education with a specific focus on social emotional health, integrity, respect, responsibility and perseverance. We engage in daily mindfulness activities that help scholars re-center themselves to excel in school. Through our unique Decision Making Period (DMP) Course, scholars learn how to self-manage during challenging situations and engage in community building activities that make them responsible individuals within a community. We have a partnership with Cypress Hills Development Corporation for Youth Development and College Readiness. Through partnerships with Lincoln Center, Brooklyn Conservatory of Music and a resident Visual Arts Program, our scholars engage in the Arts. Scholars attend multiple Broadway shows throughout the school year. We have end-of-year celebratory out-of-state trips per grade. Our STEM program allows scholars to engage in Science and Engineering courses with hands-on designing with 3-D printing. We have a hydroponic lab where scholars grow vegetable. Through our partnership with Verizon, all scholars receive a wi-fi enabled chrome book and monthly data to provide for a seamless in-person and remote learning. Our Verizon innovation lab provides scholars with innovative equipment and technology for advanced learning and inquiry. During after school clubs, scholars have multiple choices including but not limited to painting, crafting, basketball, photography, robotics, coding, dance, choir, band, Zumba, African dance and drums, poetry, fitness and soccer. We provide math and science regents courses to our eighth grade scholars. Our scholars learn Korean language. Overall, our scholars enjoy a vibrant school culture with scholar-centered staff.","start_time":"7:50am","end_time":"2:30pm","languages":null,"subway":"A, C to Shepherd Av; J to Cleveland St; Z to Norwood Av","bus":"B14, Q24, Q56, Q8","shared_building":"1","neighborhood":"East New York","latitude":40.677,"longitude":-73.8838,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.9],"n":[190.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.936,0.937,0.938,0.91,0.905,0.906,0.909],"n":[494.0,508.0,490.0,489.0,479.0,503.0,495.0],"c":[null,null,null,null,null,1.0,0.892]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.943],"n":[486.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.743,0.744,0.751,0.797,0.808,0.838,0.685,0.65,0.662,0.702],"n":[370.0,399.0,462.0,488.0,484.0,487.0,476.0,463.0,494.0,480.0],"c":[0.77,0.77,0.746,0.746,null,null,null,0.667,0.852,0.667],"s":[3.38,2.29,2.67,3.82,null,null,null,2.76,2.01,4.99],"b":["above","below","below","above",null,null,null,"below","below","high"]},"chronic_absent_ems_allea":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.893,0.833,0.879,0.8,0.654,0.667,0.65],"n":[28.0,30.0,33.0,30.0,26.0,18.0,20.0],"c":[0.82,null,null,null,null,null,null]},"chronic_absent_ems_alleb":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.783,0.802,0.775,0.621,0.596,0.657,0.596],"n":[115.0,116.0,111.0,95.0,89.0,105.0,94.0],"c":[0.723,null,null,null,null,null,null]},"chronic_absent_ems_alleh":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-2