{"school":{"dbn":"06M005","name":"P.S. 5 Ellen Lurie","boro":"Manhattan","district":"06","district_label":"District 6","report_type":"EMS","report_types":"EMS","school_type":"Elementary","grades":"3K-5","status":"open","enrollment":431,"enrollment_year":"2024-25","address":"3703 TENTH AVENUE, MANHATTAN, NY 10034","phone":"212-567-8109","website":"www.ps005m.org","directory_url":"https://www.myschools.nyc/en/schools/3k/70491","accessibility":"Fully Accessible","overview":"P.S. 5 The Ellen Lurie School is a full-service Children's Aid Community School dedicated to supporting the whole child in 3K-Grade 5. We provide a comprehensive, standards-based curriculum designed to meet the needs of all learners, including diverse and special needs students. We offer a Spanish dual language program in PreK-Grade 5 to promote bilingualism, English acquisition, and biliteracy, ensuring students thrive in a multilingual world.\n\nIn partnership with local providers, our school features on-site medical, dental, and mental health clinics, as well as a food pantry to support our community's well-being.\n\nOur dynamic, research-based curriculum prioritizes small group instruction to encourage personalized learning and student ownership of their educational journey. Beyond academics, we nurture creativity through a robust visual arts program, including arts residencies, and provide a spacious playground for students to enjoy and grow. Children who live in NYC are eligible to begin 3-K during the fall of the calendar year they turn 3. There are different types of seats available in 3-K programs; some programs may offer more than one seat type, and you can list them separately on your application. For more information, please click on the options listed below or visit nyc.gov/3K. Each early childhood setting offers key health supports. District schools and Pre-K Centers have full-time nurses on site. Please contact EarlyChildhoodHealth@schools.nyc.gov with any questions about health supports available for your child's medical needs.","start_time":"8:00 AM","end_time":"2:20 PM","languages":"Spanish","subway":"1 to Dyckman St","bus":"Bx12, Bx12-SBS, Bx18A, Bx18B, Bx40, Bx42, Bx7, BxM1, M100, M101, M3","shared_building":"0","neighborhood":null,"latitude":40.858095,"longitude":-73.922199,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.907],"st":["ok"],"n":[242.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.925,0.92,0.889,0.85,0.872,0.877,0.887],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[548.0,528.0,480.0,445.0,387.0,406.0,373.0],"c":[null,null,null,null,null,0.867,0.873]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.888],"st":["ok"],"n":[472.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.79,0.741,0.715,0.736,0.704,0.641,0.436,0.466,0.515,0.582],"st":["ok","ok","ok","ok","ok","ok","ok","ok","ok","ok"],"n":[606.0,611.0,590.0,537.0,503.0,465.0,429.0,371.0,400.0,364.0],"c":[0.792,0.765,0.762,0.747,null,null,null,0.572,0.572,0.601],"s":[2.63,1.62,1.8,2.41,null,null,null,2.24,2.47,2.81],"b":["below","low","low","below",null,null,null,"below","below","below"]},"chronic_absent_ems_allea":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[null,null,null,null,null,null,null],"st":["suppressed","suppressed","suppressed","suppressed","suppressed","suppressed","suppressed"],"n":[2.0,2.0,1.0,1.0,2.0,3.0,1.0]},"chronic_absent_ems_alleb":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.667,0.471,0.31,0.267,0.364,0.361,0.441],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[36.0,34.0,29.0,30.0,22.0,36.0,34.0],"c":[0.657,null,null,null,null,null,null]},"chronic_absent_ems_alleh":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"]