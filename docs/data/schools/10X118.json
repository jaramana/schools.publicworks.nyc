{"school":{"dbn":"10X118","name":"J.H.S. 118 William W. Niles","boro":"Bronx","district":"10","district_label":"District 10","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":470,"enrollment_year":"2024-25","address":"577 EAST 179 STREET, BRONX, NY 10457","phone":"718-796-8516","website":"ms118.info","directory_url":"https://www.myschools.nyc/en/schools/middle-school/66946","accessibility":"Partially Accessible","overview":"At JHS 118 we strive to provide all students with rigorous and individualized learning experiences that will prepare them for academic success. More than 60% of our students take the Algebra, ELA, Living Environment, and US History Regents Exams in 8th grade. In addition to the four core content areas, every student receives three years of computer science and arts courses. Our computer science program provides opportunities for students to develop computational thinking while deepening their ability to problem-solve and create. Our Arts Department provides all students the opportunity to learn a musical instrument (orchestra), perform on stage (theatre), appreciate modern and classic works of art (visual arts), and to access their individual kinesthetic intelligence (dance). We pride ourselves on the cultural diversity within our school community.  We are one school made up of three academies, Pace Academy, Spectrum Academy, and Academy of Excellence.","start_time":"08:19am","end_time":"02:39pm","languages":null,"subway":null,"bus":"Bx15, Bx17, Bx19, Bx36, Bx40, Bx41, Bx41-SBS, Bx42, Bx9","shared_building":"0","neighborhood":"East Tremont","latitude":40.8485,"longitude":-73.8924,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.829],"n":[356.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.91,0.924,0.87,0.858,0.891,0.896,0.901],"n":[1158.0