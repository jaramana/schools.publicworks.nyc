{"school":{"dbn":"17K354","name":"The School of Integrated Learning","boro":"Brooklyn","district":"17","district_label":"District 17","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":217,"enrollment_year":"2024-25","address":"1224 PARK PLACE, BROOKLYN, NY 11213","phone":"718-564-2566 extension 19251","website":"www.ms354.com","directory_url":"https://www.myschools.nyc/en/schools/middle-school/69139","accessibility":"Fully Accessible","overview":"The School of Integrated Learning Middle School 354 is an International Baccalaureate-IB school, with a focus on college and career readiness. We enrich our scholars with a high- quality curriculum, curated to enhance their preparedness for post-secondary education and career. As a newly redesigned STEM+A school, our curriculum emphasizes Science, Technology, Engineering, Math, and the Arts (STEM+A), to challenge scholars to develop problem solving and critical thinking skills. Students engage in exploratory project-based learning, learning alongside and be mentored by High school and College students, as we continue to partner with Medgar Evers Preparatory High School, PTECH, Brooklyn Technical High School and New York Institute of Technology. Additionally, all students engage in Service-Learning Projects as part of the Civics for All Curriculum. Scholars in our Phoenix Academy Screened Program (K354A) are on a fast track to sit Regents Examinations in United States History and Government, Integrated Algebra I and Living Environment, while most of our eighth-grade scholars sit the Living Environment Regents Examination. This is possible because all our seventh-grade scholars take the eighth-grade NYS Science Test. Students get to select and participate in one of four academies (Home Economics, Performing Arts, Sports, and Technology) to bolster their Social Emotional Learning and enrich their interests and talents. Each year, most of our scholars are accepted to their first-choice high school, with several of them attending specialized high schools. All classrooms have SMART/Promethean Boards; we have state-of-the-art technology and science labs; a mobile science lab, and laptop carts. As needed, scholars are provided Academic Intervention Services (AIS), to meet the New Generation Learning Standards-NGLS. We use auto-dials, email, text updates, Jupiter, a monthly newsletter, Instagram (@MS354BROOKLYN), and our school website, www.ms354.com, to keep our parents informed. Families also get the opportunity to see a Broadway show each spring.","start_time":"08:00am","end_time":"04:20pm","languages":null,"subway":"3, 4 to Utica Av","bus":"B14, B15, B17, B43, B45, B46, B46-SBS, B65","shared_building":"1","neighborhood":"Crown Heights","latitude":40.672277,"longitude":-73.937224,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.986],"st":["ok"],"n":[67.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.926,0.933,0.915,0.866,0.884,0.901,0.899],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[325.0,399.0,342.0,313.0,232.0,263.0,265.0],"c":[null,null,null,null,null,1.0,0.87]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.913],"st":["ok"],"n":[335.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.751,0.665,0.724,0.753,0.786,0.763,0.53,0.585,0.602,0.65],"st":["ok","ok","ok","ok","ok","ok","ok","ok","ok","ok"],"n":[229.0,245.0,286.0,324.0,384.0,329.0,296.0,212.0,246.0,237.0],"c":[0.708,0.671,0.709,0.726,null,null,null,0.634,0.843,0.651],"s":[4.1,2.29,3.38,3.44,null,null,null,2.57,1.74,2.6]},"chronic_absent_ems_allea":{"y":["2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[null,null,null,null,null],"st":["suppressed","suppressed","suppressed","suppressed","suppressed"],"n":[2.0,4.0,3.0,2.0,2.