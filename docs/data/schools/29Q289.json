{"school":{"dbn":"29Q289","name":"Queens United Middle School","boro":"Queens","district":"29","district_label":"District 29","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":239,"enrollment_year":"2024-25","address":"229-02 137 AVENUE, QUEENS, NY 11413","phone":"718-464-1433","website":"www.queensunited.org","directory_url":"https://www.myschools.nyc/en/schools/middle-school/72375","accessibility":"Partially Accessible","overview":"The bold Vision of Queens United Middle School 289 (QUMS) is that EVERY student will meet and exceed New York State standards in all subjects. Our Mission is to inspire students to master standards, develop a strong sense of self, and go on to make meaningful contributions to society. To achieve our Vision & Mission, we hold very high expectations for all our scholars as per the QUMS Core Values: AIR of Excellence (Accountability, Integrity, Respect, & Excellence). In partnership with families & staff who fully embrace our Vision, Mission, and Core Values, we are successfully building a safe, intimate, and nurturing learning community. QUMS offers extensive academic support through one-to-one tutoring, after-school academies, and social-emotional support for all students from our dynamic guidance and social work team.  QUMS is an official site where students take the Specialized High School Exam (SHSAT) during the school day in the Fall. As a result of our successful after-school SHSAT prep program, an alumnus from the Class of 2022 currently attends Brooklyn Technical HS. Additional early high school opportunities at QUMS include Regents courses in Living Environment, Algebra 1, and U.S. History. QUMS also offers a wide variety of activities such as Broadway Jr Musical Theater, Girls Who Game Coding Club, QUMS Young Chefs Cooking Club, and SONYC-- our free after school and summer camp program. SONYC provides students a broad range of cross-curricular and extracurricular experiences including sports, arts, and STEM project creation. Families who fully embrace our Vision, Mission, & Core Values will find that Queens United is the right fit.","start_time":"08:15am","end_time":"02:35pm","languages":null,"subway":null,"bus":"Q5, Q85, X63","shared_building":"1","neighborhood":"Laurelton","latitude":40.67255,"longitude":-73.743395,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.936],"st":["ok"],"n":[77.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.912,0.933,0.92,0.892,0.917,0.933,0.93],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[183.0,186.0,184.0,207.0,207.0,237.0,255.0],"c":[null,null,null,null,null,1.0,0.904]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.917],"st":["ok"],"n":[181.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.849,0.806,0.792,0.744,0.767,0.778,0.613,0.748,0.763,0.773],"st":["ok","ok","ok","ok","ok","ok","ok","ok","ok","ok"],"n":[245.0,247.0,216.0,180.0,180.0,176.0,194.0,202.0,232.0,251.0],"c":[0.836,0.816,0.804,0.777,null,null,null,0.716,0.888,0.746],"s":[3.76,2.31,2.33,2.06,null,null,null,3.07,4.86,4.99],"b":["above","below","below","below",null,null,null,"above","high","high"]},"chronic_absent_ems_allea":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23"],"v":[null,null,null,null,null],"st":["suppressed","suppressed","suppressed","suppressed","suppressed"],"n":[2.0,3.0,1.0,1.0,1.0]},"chronic_absent_ems_alleb":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.752,0.756,0.787,0.621,0.76,0.781,0.78],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[161.0,156.0,155.0,169.0,183.0,201.0,214.0],"c":[0.779,null,null,null,null,null,null]},"chronic_absent_ems_alleh":{"y":["2023-24","2024-25"],"v":[0.588,0.682],"st":["ok","ok"],"n":[17.0,22.0]},