{"school":{"dbn":"12X217","name":"School of Performing Arts","boro":"Bronx","district":"12","district_label":"District 12","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":137,"enrollment_year":"2024-25","address":"977 FOX STREET, BRONX, NY 10459","phone":"718-620-8160","website":"is217.org","directory_url":"https://www.myschools.nyc/en/schools/middle-school/66878","accessibility":"Partially Accessible","overview":"At I.S. 217, our mission is to enforce STARS expectations of Safety, Teamwork, Achievement, Respect, and Self-Awareness. We ignite a passion of learning through student centered approaches fostered by rich discussions, goal setting, and engaging students in project-based learning. Academic growth is upheld through continuous data analysis, and a conscious effort to expose our students to culturally responsive content to infuse rigor with a love of learning. Students have access to dance, music, choir, and visual arts programming during the school day. Through the Community Schools partnership with Replications, field trips are offered to NYC cultural and entertainment venues. Students and staff are encouraged daily to be leaders as we strive to ensure that the academic and social needs of students, parents, and families are met. At our school, we never give up on children and our motto is nothing ordinary, only the best.","start_time":"08:05am","end_time":"02:25pm","languages":null,"subway":"2, 5 to Intervale Av; 6 to Hunts Point Av","bus":"Bx17, Bx19, Bx27, Bx35, Bx4, Bx46, Bx4A, Bx5, Bx6, Bx6-SBS","shared_building":"1","neighborhood":"Longwood","latitude":40.822077,"longitude":-73.894386,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.935],"st":["ok"],"n":[106.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.904,0.919,0.936,0.869,0.862,0.879,0.