{"school":{"dbn":"15K051","name":"M.S. 51 William Alexander","boro":"Brooklyn","district":"15","district_label":"District 15","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":1035,"enrollment_year":"2024-25","address":"350 5 AVENUE, BROOKLYN, NY 11215","phone":"718-788-4482","website":"www.ms51.org","directory_url":"https://www.myschools.nyc/en/schools/middle-school/68322","accessibility":"Partially Accessible","overview":"Students enjoy an inclusive and engaging, learning environment, supported by an experienced faculty. We provide our students an honors program, including Algebra, Living Environment, and U.S. History and Government Regents in grade 8. Our program offers a three-year, in-depth study of drama, instrumental music, dance, chorus, art or photography. Students study Chinese, French, or Spanish over the city's first three year Advanced Placemen Language and Culture course, preparing them for the High School Proficiency exam. Social-emotional supports include Advisory, homeroom, restorative circles, RULER and our after school enrichment and leadership programs. The MS51 student government consists of class mayors, a school president, vice president and congress. Our social-emotional, academic and artistic programs prepare our students for the best high schools in NYC! Over 85% of our 8th graders are matched to one of their top choices. Parents have a strong voice in the School Leadership Team, Parent Association, fundraising and volunteering opportunities. Our non-captive lunch and recess allows students to explore our campus and community - outdoor play is essential to recharging the mind and fostering independence, social skills and responsible behaviors. Our students also enjoy overnight trips, field trips, and community service opportunities.  Students from low-income households, students in temporary housing, and English Language Learners (ELLs) have an admissions priority for 52% of seats at this school.","start_time":"08:39am","end_time":"03:00pm","languages":null,"subway":"F, G, R to 9th St","bus":"B103, B37, B61, B63, B67, B69","shared_building":"0","neighborhood":"Park Slope","latitude":40.672191,"longitude":-73.984456,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.891],"st":["ok"],"n":[648.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.97,0.968,0.897,0.923,0.932,0.936,0.942],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[1148.0,1162.0,1164.0,1117.0,1052.0,1033.0,1071.0],"c":[null,null,null,null,null,1.0,0.928]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.897],"st":["ok"],"n":[1164.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.953,0.951,0.949,0.949,0.94,0.66,0.758,0.794,0.803,0.836],"st":["ok","ok","ok","ok","ok","ok","ok","ok","ok","ok"],"n":[1129.0,1133.0,1143.0,1147.0,1156.0,1150.0,1097.0,1035.0,993.0,1047.0],"c":[0.927,0.922,0.915,0.907,null,null,null,0.803,0.992,0.825],"s":[4.56,4.13,4.11,4.25,null,null,null,2.98,4.84,4.99],"b":["high","high","high","high",null,null,null,"below","high","high"]},"chronic_absent_ems_allea":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.99,0.991,0.746,0.868,0.947,0.951,0.943],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[202.0,229.0,244.0,234.0,243.0,265.0,283.0],"c":[0.924,null,null,null,null,null,null]},"chronic_absent_ems_alleb":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.896,0.837,0.511,0.636,0.66,0.61,0.69],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[77.0,92.0,92.0,107.0,97.0,82.0,71.0],"c":[0.842,null,null,null,null,null,null]},"chronic_absent_ems_alleh":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.868,0.882,0.542,0.647,0.682,0.686,0