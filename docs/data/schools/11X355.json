{"school":{"dbn":"11X355","name":"Bronx Alliance Middle School","boro":"Bronx","district":"11","district_label":"District 11","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":187,"enrollment_year":"2024-25","address":"3750 BAYCHESTER AVENUE, BRONX, NY 10466","phone":"718-994-1028","website":"www.BronxAlliance.org","directory_url":"https://www.myschools.nyc/en/schools/middle-school/73088","accessibility":"Not Accessible","overview":"We are a small school making a big difference. We work to ensure every leader is academically, socially, and emotionally prepared for success in high school, college, and beyond. Our mastery-based teaching approach is designed to develop social justice minded critical thinkers, equipped to create a more kind, just, and equitable world for themselves, their families, and their community. All students follow an accelerated academic pathway where they will complete high school coursework, earn high school credits, and pass New York State Regents exams before graduating eighth grade. In addition to accelerated courses, we also offer Computer Technology, Music, Band, and Critical Media Studies where leaders analyze, critique, create media in our brand new media production lab, and use it to cultivate positive change in the world. Students will also enjoy a rich selection of elective classes that allow them to explore a variety of subjects, topics, and trades throughout their middle school tenure. Outside of the classroom, most students belong to one of our dynamic after school programs that offer fun and engaging arts, athletics, and STEM activities that reflect students\u00c3\u0083\u00c2\u00a2\u00c3\u0082\u00c2\u0080\u00c3\u0082\u00c2\u0099 interests. Programming is also provided on Saturdays, during school breaks, and in the summer. In short, there are amazing opportunities for students to be involved in structured learning and enrichment activities all year round. Yes, we are small, but we do big work. By nurturing big expectations, working hard, and leading with our hearts, we continue to make a positive difference in the lives of the children, families, and community we serve.","start_time":"07:44am","end_time":"02:19pm","languages":null,"subway":"5 to Baychester Av","bus":"Bx16, Bx30, Bx31","shared_building":"1","neighborhood":"Eastchester","latitude":40.8862,"longitude":-73.8405,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.998],"n":[118.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.918,0.911,0.902,0.836,0.884,0.9,0.888],"n":[324.0,350.0,313.0,296.0,245.0,246.0,224.0],"c":[null,null,null,null,null,1.0,0.85]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.899],"n":[305.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.747,0.664,0.58,0.745,0.659,0.659,0.399,0.596,0.637,0.675],"n":[368.0,360.0,352.0,321.0,331.0,302.0,281.0,235.0,237.0,209.0],"c":[0.722,0.714,0.695,0.667,null,null,null,0.573,0.781,0.604],"s":[4.17,1.94,1.29,4.25,null,null,null,2.97,2.24,4.86],"b":["high","low","low","high",null,null,null,"below","below","high"]},"chronic_absent_ems_allea":{"y":["2021-22"],"v":[null],"st":["suppressed"],"n":[3.0]},"chronic_absent_ems_alleb":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.822,0.717,0.703,0.453,0.618,0.727,0.724],"n":[197.0,219.0,195.0,179.0,152.0,150.0,127.0],"c":[0.678,null,null,null,null,null,null]},"chronic_absent_ems_alleh":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.602,0.524,0.567,0.276,0.549,0.462,0.575],"n":[113.0,103.0,97.0,87.0,71.0,78.0,73.0],"c":[0.64,null,null,null,null,null,null]},"chronic_absent_ems_allei":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24"],"v":[null,null,n