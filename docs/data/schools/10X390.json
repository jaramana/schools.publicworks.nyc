{"school":{"dbn":"10X390","name":"M.S. 390","boro":"Bronx","district":"10","district_label":"District 10","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":320,"enrollment_year":"2024-25","address":"1930 ANDREWS AVENUE, BRONX, NY 10453","phone":"7185840980","website":"www.ms390.com","directory_url":"https://www.myschools.nyc/en/schools/middle-school/68113","accessibility":"Not Accessible","overview":"At Middle School 390, we offer a variety of exciting and engaging extracurricular activities which keep our students actively involved, promoting equity and inclusiveness. The school culture emphasizes student social-emotional development and leadership. Students are empowered to make positive decisions through the 7 Habits of Highly Effective People- Leader in Me process; thus   fostering student engagement and leadership skills. Additionally, we foster strong relationships with families, maintaining consistent communication about student progress and open monthly parents\u00c3\u0083\u00c2\u00a2\u00c3\u0082\u00c2\u0080\u00c3\u0082\u00c2\u0099 meetings. Each class is 100% equipped with Apple technology (one-to-one iPad and laptop). We are part of the Middle School Quality Initiative, our students have access to state-of-the art technology such as, (Veative/ Virtual Reality set) which provides students with opportunity to interact and engage with their subjects in a virtual reality environment. In addition, we offer dual language and transitional bilingual programs in English and Spanish, Pre- Regents, Regents, and Specialized High School Prep Programs. These programs are designed to provide students with the opportunity to participate in Regents courses in the eighth grade (Algebra and Living Environment) and two years of Specialized High School Prep. Thus, maximizing opportunities for college and career readiness. Students are committed to engage in rigorous curricula and participate in high school and college prep programs (Cornell University-Juntos Program, Lehman College \u00c3\u0083\u00c2\u00a2\u00c3\u0082\u00c2\u0080\u00c3\u0082\u00c2\u0093 Gear Up Thrives, Bronx Community college -TRIO and Liberty Programs).","start_time":"08:19am","end_time":"02:39pm","languages":null,"subway":"4 to Burnside Av; B, D to Tremont Av","bus":"Bx1, Bx18A, Bx18B, Bx2, Bx3, Bx32, Bx36, Bx40, Bx42, BxM4","shared_building":"1","neighborhood":"University Heights","latitude":40.854537,"longitude":-73.91303,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.951,0.946,0.934,0.9,0.91,0.915,0.92],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[568.0,585.0,564.0,508.0,429.0,375.0,337.0],"c":[null,null,null,null,null,1.0,0.891]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.934],"st":["ok"],"n":[561.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.779,0.802,0.792,0.869,0.845,0.785,0.589,0.689,0.725,0.739],"st":["ok","ok","ok","ok","ok","ok","ok","ok","ok","ok"],"n":[471.0,541.0,578.0,563.0,567.0,557.0,491.0,415.0,360.0,333.0],"c":[0.766,0.733,0.709,0.737,null,null,null,0.626,0.83,0.688],"s":[4.11,3.51,3.88,4.99,null,null,null,3.24,4.86,4.99]},"chronic_absent_ems_allea":{"y":["2019-20","2020-21","2021-22","2022-23"],"v":[null,null,null,null],"st":["suppressed","suppressed","suppressed","suppressed"],"n":[3.0,3.0,2.0,1.0]},"chronic_absent_ems_alleb":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.817,0.812,0.761,0.564,0.723,0.641,0.732],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[71.0,85.0,92.0,78.0,65.0,64.0,56.0],"c":[0.684,null,null,null,null,null,null]},"chronic_absent_ems_alleh":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.876,0.848,0.787,0.593,0.684,0.744,0.751],"st":["ok","ok","ok"