{"school":{"dbn":"22K109","name":"P.S. 109","boro":"Brooklyn","district":"22","district_label":"District 22","report_type":"EMS","report_types":"EMS","school_type":"K-8","grades":"K to 8","status":"open","enrollment":581,"enrollment_year":"2024-25","address":"1001 EAST 45 STREET, BROOKLYN, NY 11203","phone":"718-743-5598","website":"https://www.schools.nyc.gov/schools/K109","directory_url":"https://www.myschools.nyc/en/schools/middle-school/63424","accessibility":"Fully Accessible","overview":"IS 109 is a small welcoming, and inclusive school with a community committed to ensuring all children feel supported and successful at this pivotal moment in their lives. We are located in the heart of East Flatbush Brooklyn.  Our curriculum is focused on challenging academics, an introduction to the Arts, and social-emotional learning. We support all students while they grow in their knowledge of themselves, one another, and the world. Students have the opportunity to choose a club during our School-Wide Enrichment period and can take regent classes if they choose (Algebra, Living Environment, US History). We want all who walk through our doors to feel safe, valued, and capable and to leave here understanding their experiences matter, they have a voice, and that they can use that voice to be aware and productive citizens in an ever-changing world. Students have opportunities to be included in the arts: music, dance, arts and have lots of opportunities to showcase their talents on stage and on the court.","start_time":"08:00am","end_time":"02:19pm","languages":null,"subway":null,"bus":"B103, B46, B46-SBS, B6, B7, B8, BM2","shared_building":"1","neighborhood":"East Flatbush","latitude":40.6361,"longitude":-73.9331,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.881],"n":[237.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.922,0.