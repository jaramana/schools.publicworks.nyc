{"school":{"dbn":"15K821","name":"Sunset Park Prep","boro":"Brooklyn","district":"15","district_label":"District 15","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":391,"enrollment_year":"2024-25","address":"4004 4 AVENUE, BROOKLYN, NY 11232","phone":"718-686-2730","website":"www.sunsetparkprep.com","directory_url":"https://www.myschools.nyc/en/schools/middle-school/72394","accessibility":"Not Accessible","overview":"Sunset Park Prep was established in the late 1990s to meet the needs of highly motivated, high achieving students in Sunset Park and the surrounding area. We provide a rigorous, standards-based program in a small school setting, assuring a safe and nurturing environment for our students, staff and families. We take particular care to support each individual student in the way they need to be successful in school. We believe that it is our responsibility to help our middle schoolers grow in their self-awareness and personal value systems as they navigate adolescence. We do this through collaborative work and hands-on student practice in the classroom, and a large number of excellent extracurricular activities and experiences, matched to individual student interest. We offer many field trip opportunities and even take overnight trips on each grade. Learning through experience and building social connections both inside and outside of school help make Prep a school where all students can connect to our school community.","start_time":"09:00am","end_time":"03:20pm","languages":null,"subway":"N to 36th St; R to 45th St","bus":"B11, B35, B37, B63, B70","shared_building":"1","neighborhood":"Sunset Park","latitude":40.652229,"longitude":-74.007415,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.866],"st":["ok"],"n":[228.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24",