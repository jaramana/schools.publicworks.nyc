{"school":{"dbn":"18K366","name":"The Science And Medicine Middle School","boro":"Brooklyn","district":"18","district_label":"District 18","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":232,"enrollment_year":"2024-25","address":"965 EAST 107TH STREET, BROOKLYN, NY 11236","phone":"718-773-3059","website":"ms366.org","directory_url":"https://www.myschools.nyc/en/schools/middle-school/66713","accessibility":"Fully Accessible","overview":"The Science and Medicine Middle School 366 is committed to providing a safe and nurturing yet academically rigorous learning environment that prepares students for high school, college, careers, and service to the world. It is our expectation that students respect themselves and others, hold themselves accountable for their actions, and always strive for excellence. We have a medical science teaching lab, complete with hospital-grade beds and equipment. Our students visit various CUNY and SUNY schools as well as Historically Black Colleges and Universities. Eighth graders have the opportunity to take the Living Environment Regents exams. Students engage in various hands-on and real-world activities through our partnerships with The Urban Advantage Science Initiative, Weill Cornell Medical College, the National Training Network, the Scripps National Spelling Bee, the Imagine That chess program, the BUILD Entrepreneurship program, the NYCPS Office of Energy and Sustainability, the District Student Advisory Council and the American Debate League.","start_time":"08:19am","end_time":"02:39pm","languages":null,"subway":"L to East 105th St","bus":"B103, B6, B60, B82, B82-SBS, B83, BM2, BM5","shared_building":"0","neighborhood":"Canarsie","latitude":40.647421,"longitude":-73.891765,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.916],"st":["ok"],"n":[178.0]},"attendance_k8_all":{"y":["2018-