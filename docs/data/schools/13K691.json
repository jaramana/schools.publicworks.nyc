{"school":{"dbn":"13K691","name":"Fort Greene Preparatory Academy","boro":"Brooklyn","district":"13","district_label":"District 13","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":229,"enrollment_year":"2024-25","address":"100 CLERMONT AVENUE, BROOKLYN, NY 11205","phone":"718-875-1021","website":"www.fortgreeneprep.org","directory_url":"https://www.myschools.nyc/en/schools/middle-school/69160","accessibility":"Not Accessible","overview":"Fort Greene Prep believes that middle school is a time for scholars to explore their interests and begin to learn about who they are. Our inquiry-based curriculum is designed to provide a wide array of content and extra curricular experiences that allows scholars to engage in our learning pathways, and in grade 8, focus on a pathway of their choice. Our pathways include--Visual Arts programming in drawing, painting, printmaking, sculpture, digital art, and ceramics. Our art programming is enriched through partnerships with Studio in a School which provides our children access to professional artists within the classroom.  Theater Arts is embedded into the Language Arts curriculum and provides students the opportunity to attend professional performances each year and create performances of their own. Partnerships with Lincoln Center Theater, Strike Anywhere Theater Ensemble, and Irondale Theater Ensemble support this work.  STEM is engaged through hands-on experimentation in the classroom, interactive field work in partnership with Urban Advantage Science, and engaging enrichment in partnership with organizations such as Global Scholars, Citizen Science, and Code.org.  Our World Language pathway allows opportunities to study either Spanish or French, and also offers a continuing pathway in French Dual Language for children who are graduating from an elementary FDL program.  We are proud of our inclusive programming that supports our children within an Integrated Co-teaching model and flexible programming to support our Students with Disabilities and Multi-lingual Learners.  All of our pathways are supported with enriching afterschool programming and opportunities for advanced studies in preparation for high school including opportunities to take the Algebra and Living Environment Regents, as well as the World Language Proficiency.  Our French Dual Language students are prepared to be on track for the Seal of Biliteracy as they enter high school.  All of our scholars develop social-emotional capacity as part of the Resilient Scholars Program, which puts students at the center of their learning and empowers our children to build an equitable culture together.  Students from low-income households and students in temporary housing have an admissions priority for 57% of seats at this school.","start_time":"08:15am","end_time":"02:39pm","languages":null,"subway":null,"bus":"B38, B54, B57, B62, B67, B69, B93","shared_building":"1","neighborhood":"Fort Greene","latitude":40.6944,"longitude":-73.9716,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.913],"n":[79.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.866,0.893,0.888,0.835,0.873,0.875,0.894],"n":[229.0,225.0,196.0,175.0,196.0,237.0,248.0],"c":[null,null,null,null,null,1.0,0.859]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.887],"n":[196.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.715,0.526,0.574,0.529,0.642,0.613,0.378,0.541,0.494,0.611],"n":[246.0,228.0,223.0,227.0,218.0,194.0,172.0,185.0,231.0,239.0],"c":[0.762,0.705,0.634,0.654,null,null,null,0.613,0.76,0.611],"s":[2.36,1.0,1.51,1.65,null,null,null,2.41,1.66,1.1],"b":["below","low","low","low",null,null,null,"below","low","low"]},"chronic_absent_ems_allea":{"y":["2020-21","2021-2