{"school":{"dbn":"12X388","name":"Pan American International High School at Monroe","boro":"Bronx","district":"12","district_label":"District 12","report_type":"HS","report_types":"HS","school_type":"High School","grades":"9 to 12","status":"open","enrollment":344,"enrollment_year":"2024-25","address":"1300 Boynton Avenue","phone":"718-991-7238","website":"https://www.paihsmonroe.org/","directory_url":"https://www.myschools.nyc/en/schools/high-school/66233","accessibility":"Partially Accessible","overview":"We are a small learning community with recently-arrived, Spanish speaking students. We focus on students academic, social and emotional development. Our students learn language through content in each subject area, including in Native Language Arts classes in Spanish. Our students only take the ELA and Algebra 1 regents exams. In lieu of the other regents exams, our students must write a subject specific paper and present their work to a panel in each subject in order to graduate.  Our culturally relevant,  group based, interdisciplinary projects help students develop their English language proficiency, gain real-world experiences, and enrich their native language literacy. Our students visit multiple college campuses each year and receive individualized support with post-secondary planning. We provide multiple opportunities for additional academic support both after school, on Saturday mornings, during breaks, and during summer school. Additionally, we provide parents/guardians with free evening and Saturday ESL classes.\n\nStudents attending our school are eligible to apply to the Bronx STEAM Center. Students accepted to Bronx STEAM will spend a portion of their school day and at least two years engaging in high quality Career and Technical Education classes at the Bronx STEAM Center in one of six career pathways aligned to critical sectors such as healthcare and technology. With support across our school and the Bronx STEAM Center, students will earn early college credit, industry credentials, participate in paid work experiences and receive personalized advising to graduate onto higher education and/or employment in family sustaining careers.","start_time":"8:35am","end_time":"3:35pm","languages":"Spanish","subway":"6 to Elder Av","bus":"Bx11, Bx21, Bx27, Bx35, Bx36, Bx4, Bx4A, Bx9, BxM6, Q44-SBS","shared_building":"1","neighborhood":"West Farms-Bronx River","latitude":40.8325,"longitude":-73.8782,"coordinate_source":"source","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_hs_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.875,0.882,0.826,0.845,0.864,0.865,0.879],"n":[531.0,471.0,405.0,391.0,385.0,403.0,403.0],"c":[null,null,null,null,null,0.871,0.845]},"attendance_inperson_hs_all":{"y":["2020-21"],"v":[0.993],"n":[256.0]},"attendance_remote_hs_all":{"y":["2020-21"],"v":[0.804],"n":[384.0]},"ccr_4yr_all":{"y":["2023-24","2024-25"],"v":[29.7,42.6],"n":[62.0,49.0],"c":[28.3,31.5],"s":[null,4.53],"b":[null,"high"]},"ccr_4yr_alleh":{"y":["2023-24","2024-25"],"v":[29.7,43.5],"n":[62.0,48.0],"c":[28.9,30.8]},"ccr_4yr_allew":{"y":["2024-25"],"v":[null],"st":["suppressed"],"n":[1.0]},"ccr_4yr_allgf":{"y":["2023-24","2024-25"],"v":[35.9,48.4],"n":[29.0,25.0]},"ccr_4yr_allgm":{"y":["2023-24","2024-25"],"v":[24.2,36.6],"n":[33.0,24.0]},"ccr_6yr_all":{"y":["2023-24","2024-25"],"v":[35.9,29.8],"n":[95.0,74.0],"c":[28.5,32.9],"s":[null,2.24],"b":[null,"below"]},"chronic_absent_hs_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.638,0.632,0.566,0.595,0.609,0.489,0.441,0.559,0.575,0.596],"n":[473.0,489.0,500.0,477.0,447.0,376.0,313.0,363.0,358.0,389.0],"c":[0.612,0.618,0.625,0.567,null,null,null,0.62,0.722,0.605],"s":[3.38,3.34,2.3,2.81,null,null,null,3.05,1.84,2.93],"b":["above","above","below","below",null,null,null,"above","low","below"]},"chronic_absent_hs_alleb":{"y":["2018-19","2019-20","2020-21","202