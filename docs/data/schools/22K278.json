{"school":{"dbn":"22K278","name":"J.H.S. 278 Marine Park","boro":"Brooklyn","district":"22","district_label":"District 22","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":861,"enrollment_year":"2024-25","address":"1925 STUART STREET, BROOKLYN, NY 11229","phone":"718-338-1534","website":"www.marineparkis278.org","directory_url":"https://www.myschools.nyc/en/schools/middle-school/68722","accessibility":"Not Accessible","overview":"Marine Park Junior High School 278 is located in the westernmost point of Jamaica Bay, in Brooklyn, NY. MP JHS 278 provides an enriched, nurturing environment to foster students\u00c3\u00a2\u00c2\u0080\u00c2\u0099 creativity, talents and interests through rigorous academic, accelerated and enrichment programs. Students engage in exceptional educational and social emotional opportunities focusing on college and career readiness through innovative project-based learning, and various academic programs, including STEAM, Instrumental Music, Chorus, Theatre, Dance, Visual/Digital Art and Computer Sciences. Our children spend their Middle School years with nurturing teachers in a caring community that prepare them academically, physically, and social-emotionally for the demands of the 21st-century world. Students, staff and parents work collaboratively for students to achieve academic excellence in an atmosphere that embraces all learning styles, diverse needs and abilities. We understand the value of a true school/home partnership.","start_time":"08:00am","end_time":"02:19pm","languages":null,"subway":null,"bus":"B100, B2, B3, B31, B36, B44, B44-SBS, BM4","shared_building":"0","neighborhood":"Marine Park","latitude":40.60668,"longitude":-73.938531,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.827],"st":["ok"],"n":[569.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-