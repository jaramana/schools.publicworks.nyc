{"school":{"dbn":"10X391","name":"The Angelo Patri Middle School","boro":"Bronx","district":"10","district_label":"District 10","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":340,"enrollment_year":"2024-25","address":"2225 WEBSTER AVENUE, BRONX, NY 10457","phone":"718-365-5035","website":null,"directory_url":"https://www.myschools.nyc/en/schools/middle-school/62189","accessibility":"Partially Accessible","overview":"As a Community School, The Angelo Patri School aims to build and solidify a successful, culturally responsive environment that demonstrates genuine care for our scholars, our families, and our community. Through our CBO and other partnerships, we are able to provide food and clothing on a monthly basis to all of our families in need (e.g. GAP and NYC Food Pantry, Stop and Shop, etc.). \nWe continue to develop instructional practices to engage students at their highest level towards obtaining and exceeding grade leveled mastery.  As a MSQI school, we focus on literacy and language development to address the needs of accelerated students as well as students in need of remediation skills. We value and support our students' voice as we focus on student leadership skills and social-emotional support through the 'Leader in Me' program.  With this engagement, families see how scholars are striving for excellence/success while developing a mutual partnership with the school. Parents are encouraged and expected to monitor their child's academic progress through the use of our online grading system, Skedula. \nStudents also experience the integration of technology into all content areas as every child is provided with a laptop. Our enrichment activities encourage student choice such as: Arts, Sports, , ALL Regents classes: English, Global History, living environment and Algebra, theater/drama (Broadway Junior), music, Coding classes, College/University trips to Howard, Yale, Rutgers, Building Beats, and academic and extracurricular programs after-school MON-FRI including Saturday programs to enrich their learning and develop social skills.  GO RAMS!!!! Respect, Accountability, Maturity, & Success!!","start_time":"08:00am","end_time":"02:19pm","languages":null,"subway":"4 to 183rd St; B, D to 182nd-183rd Sts","bus":"Bx1, Bx15, Bx2, Bx32, Bx36, Bx40, Bx41, Bx41-SBS, Bx42, BxM4","shared_building":"1","neighborhood":"Tremont","latitude":40.854404,"longitude":-73.897219,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.919],"st":["ok"],"n":[216.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.918,0.92,0.872,0.867,0.884,0.909,0.911],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[537.0,510.0,432.0,409.0,413.0,427.0,397.0],"c":[null,null,null,null,null,1.0,0.872]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.866],"st":["ok"],"n":[424.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.726,0.797,0.715,0.754,0.741,0.613,0.492,0.614,0.694,0.672],"st":["ok","ok","ok","ok","ok","ok","ok","ok","ok","ok"],"n":[540.0,571.0,578.0,524.0,487.0,419.0,396.0,396.0,415.0,381.0],"c":[0.724,0.703,0.725,0.709,null,null,null,0.569,0.776,0.614],"s":[4.07,4.24,2.86,3.46,null,null,null,3.09,4.87,4.83],"b":["high","high","below","above",null,null,null,"above","high","high"]},"chronic_absent_ems_allea":{"y":["2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[null,null,null,null,null],"st":["suppressed","suppressed","suppressed","suppressed","suppressed"],"n":[2.0,2.0,1.0,1.0,3.0]},"chronic_absent_ems_alleb":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.737,0.743,0.583,0.511,0.537,0.689,0.671],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[118.0,109.0,96.0,88.0,82.0,90.0,79.0],"c":[0.666,null,null,null,null,nul