{"school":{"dbn":"16K765","name":"Nelson Mandela High School","boro":"Brooklyn","district":"16","district_label":"District 16","report_type":"HS","report_types":"HS","school_type":"High School","grades":"9 to 12","status":"open","enrollment":136,"enrollment_year":"2024-25","address":"1700 Fulton Street","phone":"718-804-6805","website":"http://mandelaschoolnyc.org","directory_url":"https://www.myschools.nyc/en/schools/high-school/63498","accessibility":"Partially Accessible","overview":"Nelson Mandela High School for Social Justice   takes a student centered approach to encourage healthy identity growth, a critical conscious understanding of the world, and adopting inquiry techniques that support student independence and leadership. \n\nMandela uses media to offer two pathways to explore social justice study: 1.Civics and 2. Technology. Students are able to gain credentials that support employment and further education in each field. Students also engage in metacognitive educational practices organized through the International Baccalaureate Organization. Every student will have an opportunity to earn a job ready Computer Science certifications, immersive experiences in law, social justice and community service that can lead to a New York State recognized Civic Seal. \n\nMandela partners with NEST and offer exclusive seats into this educational program. Mandela also has a relationship with the Nelson Mandela foundation, a South African based organization that focuses on empowering world connections that represents Nelson Mandela\u00c3\u00a2\u00c2\u0080\u00c2\u0099s vision around education and equity. We look to give every student an opportunity to travel to South Africa and internationally.\n\nMandela is part of the Boys and Girls High School educational campus. Students are encouraged to participate on Boys and Girls Campus Sports teams that include the 2023-24 PSAL New York City 3A Championship Football team, basketball, volleyball, soccer, and track and field. All Nelson Mandela students can take part on campus sports, but also create club sports through student needs. \nAs a small community,  we look to fill the needs of each of our students as they express interest.","start_time":"8:30am","end_time":"3:09pm","languages":null,"subway":"A, C to Utica Av","bus":"B15, B25, B26, B43, B45, B46, B46-SBS, B65","shared_building":"1","neighborhood":"Bedford-Stuyvesant","latitude":40.6785,"longitude":-73.9316,"coordinate_source":"source","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_hs_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.735,0.72,0.817,0.78,0.793,0.817,0.848],"n":[279.0,270.0,191.0,179.0,183.0,202.0,176.0],"c":[null,null,null,null,null,0.775,0.787]},"attendance_inperson_hs_all":{"y":["2020-21"],"v":[0.806],"n":[23.0]},"attendance_remote_hs_all":{"y":["2020-21"],"v":[0.813],"n":[190.0]},"ccr_4yr_all":{"y":["2023-24","2024-25"],"v":[31.7,26.6],"n":[33.0,26.0],"c":[31.4,40.9],"s":[null,1.16],"b":[null,"low"]},"ccr_4yr_allea":{"y":["2023-24"],"v":[null],"st":["suppressed"],"n":[2.0]},"ccr_4yr_alleb":{"y":["2023-24","2024-25"],"v":[33.2,26.3],"n":[26.0,23.0],"c":[30.8,38.7]},"ccr_4yr_alleh":{"y":["2024-25"],"v":[null],"st":["suppressed"],"n":[2.0]},"ccr_4yr_allei":{"y":["2024-25"],"v":[null],"st":["suppressed"],"n":[1.0]},"ccr_4yr_allgf":{"y":["2023-24"],"v":[30.3],"n":[15.0]},"ccr_4yr_allgm":{"y":["2023-24","2024-25"],"v":[32.8,26.0],"n":[18.0,15.0]},"ccr_6yr_all":{"y":["2023-24","2024-25"],"v":[21.2,28.0],"n":[40.0,35.0],"c":[30.0,35.4],"s":[null,1.7],"b":[null,"low"]},"chronic_absent_hs_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.507,0.37,0.296,0.289,0.277,0.505,0.299,0.373,0.446,0.516],"n":[229.0,297.0,287.0,263.0,242.0,188.0,164.0,158.0,175.0,155.0],"c":[0.585,0.522,0.502,0.485,null,null,null,0.491,0.524,0.54],"s":[2.07,1.28,1.13,1.11,null,null,null,2.8,2.3,2.76],"b":["below","low","lo