{"school":{"dbn":"31R039","name":"P.S. 39 Francis J. Murphy Jr.","boro":"Staten Island","district":"31","district_label":"District 31","report_type":"EMS","report_types":"EMS","school_type":"Elementary","grades":"K-5","status":"open","enrollment":492,"enrollment_year":"2024-25","address":"99 Macfarland Avenue, Staten Island, NY 10305","phone":"718-447-4543","website":"HTTP://WWW.PS39R.ORG","directory_url":"https://www.myschools.nyc/en/schools/kindergarten/69056","accessibility":"Partially Accessible","overview":"Public School 39\u00c3\u00a2\u00c2\u0080\u00c2\u0099s mission is to embrace the needs of each child, meeting each unique learner where they are at, and propelling them forward. Cooperatively, we strive to build a strong foundation for all, by creating a safe and affirming environment promoting mutual respect, student agency, and authentic partnerships with teachers. Our students own their learning. All students engage with culturally-response texts and rigorous digital instruction to hone and develop skills needed to be 21st Century global citizens.\nWe offer a hands on approach to learning and have been following the HMH Into Reading Curriculum for five years.  Our state of the art STREAM lab offers our students the ability to hone their technological skills.  We have established a brand new Wellness Room for the improved mental health of all of our student body and staff.  At PS 39 we have a sense of pride in all that we do!\nPS 39 opens a half hour before school begins for hot breakfast!  We are also a uniform school!","start_time":"8:00 AM","end_time":"2:20 PM","languages":null,"subway":null,"bus":"S51, S52, S53, S78, S79-SBS, S81, S93, SIM1, SIM10, SIM11, SIM15, SIM1C, SIM33C, SIM35, SIM3C, SIM5, SIM6, SIM7, SIM9","shared_building":"0","neighborhood":null,"latitude":40.597969,"longitude":-74.06996,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.939],"st":["ok"],"