{"school":{"dbn":"08X337","name":"The School for Inquiry and Social Justice","boro":"Bronx","district":"08","district_label":"District 8","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":383,"enrollment_year":"2024-25","address":"1025 MORRISON AVENUE, BRONX, NY 10472","phone":"718-617-7395","website":"ms337.org","directory_url":"https://www.myschools.nyc/en/schools/middle-school/72507","accessibility":"Not Accessible","overview":"The School for Inquiry and Social Justice is a middle school that provides students with opportunities to explore and achieve academic excellence and social advocacy for their community. At MS 337, students engage in academic accelerated course work such as the Algebra (Math) Regents and the Living Environment (Science) Regents. We also provide students with academic intervention opportunities to support growth in reading and math. Our Special Education department ensures that all students across all grades who receive special education services have knowledge of their services and opportunities to participate in making decisions about their needs and how they can best be met.     In addition to our afterschool program run by Eastside House, MS 337 has a robust offering of clubs that are taught by teachers. These clubs include Change Agents (focused on community change and service learning), Gender Sexuality Alliance (GSA, focused on inclusivity, Debate, and Music. We also have a strong afterschool sports program including basketball, volleyball, soccer, and cheerleading.  We are also fortunate to be a Broadway Junior affiliated school that works alongside production specialists, set designers, teachers, and other support staff all year to produce and perform a Broadway show every spring. This partnership with Broadway Junior has exposed our students to theater experiences that has allowed them to learn acting skills, how to design their own sets, costume making, and managing and working stage lights.  MS 337\u00c3\u0083\u00c2\u00a2\u00c3\u0082\u00c2\u0080\u00c3\u0082\u00c2\u0099s mission is to educate students with a holistic approach. We believe that is how students learn the value in education.","start_time":"08:06am","end_time":"02:26pm","languages":null,"subway":"6 to Morrison Av-Soundview Av","bus":"Bx27, Bx4, Bx4A, Bx5","shared_building":"1","neighborhood":"Soundview","latitude":40.825,"longitude":-73.874,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.947],"n":[146.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.928,0.932,0.903,0.899,0.911,0.918,0.9],"n":[521.0,511.0,465.0,462.0,437.0,446.0,418.0],"c":[null,null,null,null,null,1.0,0.893]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.898],"n":[464.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.766,0.798,0.734,0.738,0.78,0.691,0.599,0.711,0.705,0.644],"n":[475.0,549.0,527.0,515.0,501.0,463.0,454.0,425.0,438.0,404.0],"c":[0.776,0.751,0.75,0.779,null,null,null,0.709,0.896,0.681],"s":[3.46,3.31,2.55,2.53,null,null,null,2.9,4.84,1.3],"b":["above","above","below","below",null,null,null,"below","high","low"]},"chronic_absent_ems_allea":{"y":["2022-23","2023-24","2024-25"],"v":[0.733,0.75,0.75],"n":[15.0,16.0,16.0]},"chronic_absent_ems_alleb":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.685,0.682,0.659,0.603,0.691,0.623,0.509],"n":[108.0,107.0,85.0,73.0,68.0,61.0,53.0],"c":[0.753,null,null,null,null,null,null]},"chronic_absent_ems_alleh":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.757,0.802,0.69,0.594,0.706,0.725,0.655],"n":[375.0,368.0,348.0,340.0,327.0,342.0,325.0],"c":[0.785,null,null,null,null,null,null]},"chronic_absent_ems_allem":{"y":["2018-19","2019-20","20