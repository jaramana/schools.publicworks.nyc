{"school":{"dbn":"26Q266","name":"P.S./I.S. 266","boro":"Queens","district":"26","district_label":"District 26","report_type":"EMS","report_types":"EMS","school_type":"K-8","grades":"K to 8","status":"open","enrollment":468,"enrollment_year":"2024-25","address":"74-10 COMMONWEALTH BOULEVARD, QUEENS, NY 11426","phone":"718-634-7914","website":"www.psis266.org","directory_url":"https://www.myschools.nyc/en/schools/middle-school/66600","accessibility":"Fully Accessible","overview":"PS/IS 266Q is a non-zoned Pre K-8 District 26 school located on the beautiful Frank Padavan Campus in Bellerose, Queens. We are dedicated to #highstandards & #academicexcellence, while cultivating a nurturing environment supporting children's social-emotional development. PS/IS 266Q empowers students in the classroom to take ownership of learning opportunities. Students are immersed in inquiry-based learning across all subject areas, challenging them to engage in close reading and produce writing and work products that showcase their content knowledge and voice as a writer. PS/IS 266Q has embraced the Citywide Literacy initiative and emerged as a Phase 1 school for the integration of the HMH ELA curriculum. Additionally, our Amplify Science curriculum is lab oriented and combines hands-on and technology-driven lessons that maximize students' learning opportunities. Our approach to math instruction includes a balance of authentic, real-world tasks, established speaking and listening protocols for engaging math-talk and hands-on differentiated work. Our staff and students are wll prepared to transition to adopting the Illustrative Math curriculum to further our schoolwide proficiency with mathematics. By the Eighth grade, all students are prepared for access to the Algebra I and/or Living Environment Regents. With our focus on positive supports for the whole child, we also believe learning occurs outside of academics. We offer activities like Debate, coding, a Pre K-8 Drama program, and award-winning Festival Choir and athletic clubs like CHAMPS, as well as basketball, volleyball, Bocci and the Rising NY Road Runners.","start_time":"08:00am","end_time":"02:19pm","languages":null,"subway":null,"bus":"Q36, Q46, QM36, QM6","shared_building":"0","neighborhood":"Glen Oaks","latitude":40.74551,"longitude":-73.728181,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.976],"st":["ok"],"n":[300.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.95,0.952,0.982,0.926,0.935,0.927,0.932],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[644.0,622.0,583.0,550.0,492.0,493.0,469.0],"c":[null,null,null,null,null,0.988,0.909]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.983],"st":["ok"],"n":[580.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.952,0.931,0.902,0.89,0.898,0.979,0.757,0.778,0.746,0.772],"st":["ok","ok","ok","ok","ok","ok","ok","ok","ok","ok"],"n":[648.0,651.0,653.0,636.0,607.0,570.0,530.0,482.0,484.0,464.0],"c":[0.921,0.906,0.868,0.886,null,null,null,0.773,0.844,0.76],"s":[4.64,3.44,2.98,3.43,null,null,null,2.72,4.86,4.99],"b":["high","above","below","above",null,null,null,"below","high","high"]},"chronic_absent_ems_allea":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.92,0.916,0.967,0.803,0.837,0.767,0.77],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[237.0,202.0,180.0,152.0,135.0,133.0,126.0],"c":[0.896,null,null,null,null,null,null]},"chronic_absent_ems_alleb":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.866,0.882,0.967,0.74,0.763,0.761,0.771],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[142.0,153.0,153.0,150.0,152.0,155.0,144.0],"c":[0.875,null,null,null,null,null,null]},"chronic_absent_ems_alleh":{"y":["2018-19","2019-20","2020-21","202