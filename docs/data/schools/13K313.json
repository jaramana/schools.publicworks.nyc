{"school":{"dbn":"13K313","name":"Dock Street School for STEAM Studies","boro":"Brooklyn","district":"13","district_label":"District 13","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":219,"enrollment_year":"2024-25","address":"19 DOCK STREET, BROOKLYN, NY 11201","phone":"718-399-1061","website":null,"directory_url":"https://www.myschools.nyc/en/schools/middle-school/64133","accessibility":"Fully Accessible","overview":"The Dock Street School is a public middle school that provides a rigorous and nurturing college preparatory education with a strong emphasis on science, technology, engineering, the arts and math (STEAM). Our goal is to foster curiosity, promote student voice and agency, and enhance problem solving skills so that our students are able to adapt to an ever changing and complex world as reflective lifelong learners.    At the Dock Street School, all students engage in a continuum of rigorous academic courses, culminating in Regents Level classes and the opportunity to specialize in STEAM Courses. Through various enriched academic experiences such as the Consortium for Research and Robotics STEM Program, Future World Vision program with Brooklyn Tech, and our affiliation with Pratt Institute, students build upon their existing critical-thinking skills and become decision makers who act responsibly and compassionately within their communities.","start_time":"08:00am","end_time":"02:19pm","languages":null,"subway":"2, 3, 4, 5, A, C, J, Z to High St; F to York St","bus":"B103, B25, B26, B38, B52, B67, B69, SIM11, SIM3, SIM31, SIM6, X37, X38","shared_building":"1","neighborhood":"DUMBO","latitude":40.702963,"longitude":-73.992072,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.991],"st":["ok"],"n":[103.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":