{"school":{"dbn":"08X562","name":"Pugsley Preparatory Academy","boro":"Bronx","district":"08","district_label":"District 8","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":549,"enrollment_year":"2024-25","address":"1111 PUGSLEY AVENUE, BRONX, NY 10472","phone":"718-583-6655","website":null,"directory_url":"https://www.myschools.nyc/en/schools/middle-school/66330","accessibility":"Partially Accessible","overview":"Pugsley Preparatory Academy students receive a rigorous educational experience centered on the belief that, \u00c3\u00a2\u00c2\u0080\u00c2\u009cEvery student has genius.\u00c3\u00a2\u00c2\u0080\u00c2\u009d To that end, we offer Next Generation aligned curricula in all core subjects and 8th grade Regents courses in Biology and Algebra. We also incorporate over twenty before and after school clubs aligned to student interests and teacher expertise to cultivate student genius. Clubs include, but certainly not limited to, cosmetology, debate, online gaming, photography, art, student government, dance, Broadway Junior theater, Lego robotics, hydroponics, co-ed sports teams (baseball, flag football, soccer, volleyball, and basketball), chess and nail technology. Students partake in trips to high schools, colleges, cultural institutions to learn about careers to inform their paths. Our school is specifically designed to give students the knowledge that will put them on the road to high school, college and careers.","start_time":"08:19am","end_time":"02:39pm","languages":null,"subway":"6 to Parkchester-East 177th St","bus":"Bx11, Bx22, Bx36, Bx39, Bx4, Bx4A, Bx5, BxM6, BxM8, Q44-SBS","shared_building":"1","neighborhood":"Unionport","latitude":40.829203,"longitude":-73.857709,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.958],"st":["ok"],"n":[223.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-