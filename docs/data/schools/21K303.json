{"school":{"dbn":"21K303","name":"I.S. 303 Herbert S. Eisenberg","boro":"Brooklyn","district":"21","district_label":"District 21","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":433,"enrollment_year":"2024-25","address":"501 WEST AVENUE, BROOKLYN, NY 11224","phone":"718-333-7850","website":"www.IS303.com","directory_url":"https://www.myschools.nyc/en/schools/middle-school/63066","accessibility":"Fully Accessible","overview":"At  I.S 303 we believe that all children are capable of excellence. It is our goal as a school community to have each of our students reach their maximum potential not only academically, but socially and emotionally as well. We believe that with heart, and strong character, all children can be successful citizens who make positive contributions to society. Honesty, empathy, accountability, respect, and teamwork (HEART)are the core values that we strive to build within our students inside and outside of the classroom.  Our teachers work to build collaborative classroom environments where all students have the opportunity to be successful through hands-on projects that are reflective of real world situations. Students are challenged in all of their their classes, with opportunities to take advanced regents courses in mathematics and science. In addition to academic programs, we also give students the opportunity to explore various talent areas including music, dance, STEM, media, and art. Our classrooms are a safe haven for students where they are supported to reach new heights and discover new interests.  With our new Russian Dual Language program, we continue to embrace the diversity of our community. Through the Russian Dual Language program, students have the chance to earn a Seal of Biliteracy in Russian and in English. Our diversity is our strength. We want all of our students to value who they are and where they come from.  At I.S 303, students display Heart, give Heart,and receive Heart in all that they do. Each child is given an educational experience tailored to their needs. Through high expectations and positive teacher student relationships we ensure that all of our children have the tools to be successful in middle school, high school, and beyond.","start_time":"08:00am","end_time":"02:19pm","languages":null,"subway":"F to Neptune Av-Van Siclen; Q to Ocean Parkway","bus":"B1, B36, B4, B68","shared_building":"0","neighborhood":"Coney Island","latitude":40.582501,"longitude":-73.97263,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.929],"st":["ok"],"n":[325.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.924,0.927,0.874,0.883,0.912,0.916,0.908],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[600.0,619.0,546.0,490.0,485.0,447.0,486.0],"c":[null,null,null,null,null,1.0,0.89]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.862],"st":["ok"],"n":[546.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.78,0.774,0.723,0.746,0.771,0.553,0.606,0.738,0.694,0.656],"st":["ok","ok","ok","ok","ok","ok","ok","ok","ok","ok"],"n":[519.0,530.0,570.0,590.0,599.0,539.0,467.0,465.0,422.0,459.0],"c":[0.828,0.81,0.783,0.792,null,null,null,0.666,0.878,0.671],"s":[2.69,1.93,1.81,2.16,null,null,null,3.3,4.84,2.02]},"chronic_absent_ems_allea":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.808,0.828,0.612,0.782,0.784,0.698,0.674],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[130.0,122.0,121.0,101.0,102.0,86.0,86.0],"c":[0.813,null,null,null,null,null,null]},"chronic_absent_ems_alleb":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.656,0.571,0.358,0.382,0.565,0.5,0.446],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[61.0,84.0,67.0,55.0,46.0,50.0,65.0