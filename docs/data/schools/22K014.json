{"school":{"dbn":"22K014","name":"J.H.S. 014 Shell Bank","boro":"Brooklyn","district":"22","district_label":"District 22","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":486,"enrollment_year":"2024-25","address":"2424 BATCHELDER STREET, BROOKLYN, NY 11235","phone":"(718)763-4701","website":"www.shellbankjhs.org","directory_url":"https://www.myschools.nyc/en/schools/middle-school/70968","accessibility":"Partially Accessible","overview":"Shell Bank Middle School, located in Sheepshead Bay, is a vibrant educational institution committed to providing a well-rounded education through unique programs that enhance learning and foster critical thinking skills.  Shell Bank's celebrated school-wide enrichment approach provides challenging and engaging learning opportunities for all students within the school community. Shell Bank goes beyond the traditional education model and enriches all learners by offering a variety of activities, programs, and resources that cater to different interests, talents, and abilities. The school celebrates cultural diversity, creating an inclusive environment that respects and integrates various cultural backgrounds. Shell Bank offers a comprehensive educational experience that embraces innovative programs that foster a culture of curiosity, exploration, and creativity, allowing every student to discover and develop their unique strengths while promoting a love for learning.  Infinity at Shell Bank- District 22 Screened Program for Advanced Learners  Shell Bank features the Infinity program, the only screened advanced learners' program in District 22, designed to expand learning opportunities beyond the regular curriculum. Our Infinity program offers a rigorous academic curriculum paired with immersive learning opportunities, focusing on critical thinking, creativity, and collaboration. Students engage in real-world experiences and hands-on projects, supported by expert guidance. The Infinity program offers students accelerated classes, providing access to Regents courses such as Algebra 1, Living Environment, Social Studies and English Regents, enabling them to advance their academic achievements and prepare for high school. Students also explore music, dance, art, technology, Chinese language, and specialized high school preparation. Recognized by prestigious schools like Hunter High School, Infinity prepares students for high academic achievements and future success. Join us at Infinity to see your child thrive in an environment that values learning, creativity, and excellence.","start_time":"08:00am","end_time":"02:45pm","languages":null,"subway":null,"bus":"B3, B31, B36, B4, B44, B44-SBS, BM3, BM4","shared_building":"0","neighborhood":"Sheepshead Bay","latitude":40.5935,"longitude":-73.9381,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.929],"n":[222.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.92,0.934,0.901,0.869,0.877,0.88,0.884],"n":[571.0,571.0,555.0,547.0,572.0,562.0,543.0],"c":[null,null,null,null,null,1.0,0.868]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.899],"n":[552.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.703,0.686,0.618,0.746,0.796,0.729,0.475,0.495,0.52,0.514],"n":[573.0,599.0,573.0,567.0,558.0,547.0,528.0,552.0,546.0,533.0],"c":[0.76,0.761,0.763,0.798,null,null,null,0.611,0.774,0.588],"s":[2.81,1.87,1.0,2.59,null,null,null,2.15,1.7,1.0],"b":["below","low","low","below",null,null,null,"below","low","low"]},"chronic_absent_ems_allea":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.806,0.866,0.85,0.531,0.6,0.58,0.627],"n":[93.0,82.0,80.0,64.0,70.0,69.0,75.0],"c":[0.842,null,null,null,null,null,null]},"chronic_absent_ems_alleb":{"y