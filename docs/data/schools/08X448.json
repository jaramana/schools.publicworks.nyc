{"school":{"dbn":"08X448","name":"Soundview Academy for Culture and Scholarship","boro":"Bronx","district":"08","district_label":"District 8","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":239,"enrollment_year":"2024-25","address":"885 BOLTON AVENUE, BRONX, NY 10473","phone":"718-829-3254","website":"www.soundviewacademy.org","directory_url":"https://www.myschools.nyc/en/schools/middle-school/69030","accessibility":"Partially Accessible","overview":"At Soundview Academy for Culture & Scholarship, we value our students, treat them with respect, challenge them academically, and support them through any personal challenges. We infuse our district-wide Language & Arts Program with a 1-to-1 student-to-iPad classroom environment to provide a 21st-century approach to teaching and learning. Instruction is individualized and delivered through global, state-of-the-art online and hands-on curricula. Students also specialize in either media arts, theater or dance while strengthening their social-emotional and linguistic competencies with our mentorship, English as a New Language and Spanish Dual Language programs. Students of a particular zone and Spanish Dual Language students are given priority for this program. Families cherish the commitment of our teachers who create instruction that leverages student interest and real-world application. They also appreciate our open-door policy, regular updates of grades and the constant outreach by mentors on their children's academic and social progress.","start_time":"8:00am","end_time":"2:20pm","languages":null,"subway":null,"bus":"Bx27, Bx36, Bx39, Bx5, BxM8","shared_building":"1","neighborhood":"Soundview","latitude":40.823,"longitude":-73.8601,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.329],"n":[100.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022