{"school":{"dbn":"18K581","name":"The Middle School of Media, Law and Fine Arts","boro":"Brooklyn","district":"18","district_label":"District 18","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":178,"enrollment_year":"2024-25","address":"905 WINTHROP STREET, BROOKLYN, NY 11203","phone":"7183427563","website":"WWW.MLFA581.COM","directory_url":"https://www.myschools.nyc/en/schools/middle-school/66415","accessibility":"Not Accessible","overview":"Our mission at The Middle School of Media, Law and Fine Arts (MLFA) is to empower our scholars in reaching their highest academic and individual potential through hands-on station-teaching and learning. We strongly believe in Molding Leaders into Fearless Advocates (MLFA) by providing all students with rigorous instruction that exposes them to media, law, and fine arts in all aspects of their learning experience.\n\nOur solid and renowned academic program includes regents track courses in US History, Living Environment, and Algebra. This is coupled with 5 differentiated intervention classes in literacy and mathematics to meet and expand our scholars' proficiency levels. We are also proud to offer 6 periods of art/sports electives in various disciplines such as visual arts, drums, horns, media, robotics, contemporary dance, hip hop, track, and varsity basketball. We anticipate adding art sections in guitar, drama, and culinary arts by Fall 2022. These efforts and offerings have crystallized into acceptance letters to specialized high schools such as LaGuardia High School for the Performing Arts, Brooklyn Technical High School, and Brooklyn College Academy.  \n\nAdditionally, our scholars have the opportunity to partake in social-emotional skill building morning check-ins, individual/group counseling, meditation services, and high school articulation classes in our state-of-the-art Makerspace, computer lab, and brand new dance studio. This is due to our robust partnerships with at least four Community-Based Organizations that harbor a group of specialists inclusive of at least 5 social workers. Students and teachers also enjoy the benefit of utilizing technology in their daily instruction/learning as every classroom is equipped with laptops and smartboards. Finally, we offer two ExpandEd after-school programs that provide an array of extracurricular activities, homework help, and tutoring from 2:40-5:30 pm every day. We hope that after learning about our school, you will join our MLFA family this upcoming year! See you this Fall!","start_time":"8:19:59 AM","end_time":"2:39:59 PM","languages":null,"subway":null,"bus":"B12, B15, B17, B35, B46, B46-SBS, B47, B7","shared_building":"1","neighborhood":"East Flatbush","latitude":40.6589,"longitude":-73.9285,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.895],"n":[74.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.921,0.915,0.858,0.861,0.874,0.865,0.887],"n":[300.0,265.0,223.0,199.0,233.0,246.0,204.0],"c":[null,null,null,null,null,1.0,0.868]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.857],"n":[217.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.799,0.853,0.857,0.723,0.701,0.545,0.508,0.559,0.472,0.595],"n":[139.0,143.0,140.0,292.0,244.0,211.0,189.0,227.0,233.0,200.0],"c":[0.706,0.7,0.65,0.668,null,null,null,0.62,0.765,0.604],"s":[4.51,4.8,4.99,4.23,null,null,null,2.51,1.54,1.07],"b":["high","high","high","high",null,null,null,"below","low","low"]},"chronic_absent_ems_allea":{"y":["2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[null,null,null,null,null,null],"st":["suppressed","suppressed","suppressed","suppressed","suppressed","suppressed"],"n":[1.0,2.0,1.0,3.0,3.0,3.0]},"chronic_absent_ems_alleb":{"y":["2018-19","20