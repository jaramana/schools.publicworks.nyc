{"school":{"dbn":"15K428","name":"Global Innovators Academy","boro":"Brooklyn","district":"15","district_label":"District 15","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6","status":"open","enrollment":49,"enrollment_year":"2024-25","address":"4222 4th Avenue, Brooklyn, NY 11232","phone":"(718) 369- 4480","website":"ms428.org","directory_url":"https://www.myschools.nyc/en/schools/middle-school/62463","accessibility":"Not Accessible","overview":"Global Innovators Academy, located in Sunset Park. MS 428 is a dual language middle school in District 15 where Chinese and Spanish programs are offered. This trailblazing middle school with project-based integration is set to build the next generation of compassionate global citizens who are bilingual, biliterate, and bicultural. Our mission is to embrace the power of language, rigorous academics, and cross-cultural collaboration to prepare students for the world of tomorrow. \nOur mission is to foster a safe learning environment centered on valuing an individual\u00c3\u00a2\u00c2\u0080\u00c2\u0099s strength, identity, culture, and heritage and establishing a harmonious diverse community. We are committed to prioritizing high academic achievement through an equitable, culturally responsive curriculum with project-based learning integration. We provide opportunities for collaboration with diverse populations through workshops and projects to build community impact. Our innovative approach to language learning is the highlight of our school model. We incorporate interdisciplinary instruction by integrating community service projects into our core curricula while leveraging the power of language. Our creative scheduling and high-quality curriculum provide equitable opportunities to meet the needs of diverse learners, and readily prepare them for college and career. Opening in September 2024, we invite students who are exhilarated by an immersive dual-language learning environment to embark on their middle school journey with us. Students have opportunities to be involved in community building where we cultivate youth leaders who are equipped to compete in the world of tomorrow.","start_time":"8:00 AM","end_time":"2:20 PM","languages":null,"subway":null,"bus":null,"shared_building":"0","neighborhood":null,"latitude":40.6508,"longitude":-74.0086,"coordinate_source":"geocoded","first_year":"2024-25","last_year":"2024-25"},"series":{"attendance_k8_all":{"y":["2024-25"],"v":[0.949],"n":[52.0],"c":[0.904]},"chronic_absent_ems_all":{"y":["2024-25"],"v":[0.846],"n":[52.0],"c":[0.741],"s":[4.99],"b":["high"]},"chronic_absent_ems_alleh":{"y":["2024-25"],"v":[0.811],"n":[37.0]},"chronic_absent_ems_allei":{"y":["2024-25"],"v":[null],"st":["suppressed"],"n":[1.0]},"chronic_absent_ems_allew":{"y":["2024-25"],"v":[null],"st":["suppressed"],"n":[1.0]},"chronic_absent_ems_allgf":{"y":["2024-25"],"v":[0.833],"n":[24.0]},"chronic_absent_ems_allgm":{"y":["2024-25"],"v":[0.857],"n":[28.0]},"demo_economic_need_index":{"y":["2024-25"],"v":[0.9078],"n":[49.0]},"demo_enrollment_total":{"y":["2024-25"],"v":[49.0],"n":[49.0]},"demo_pct_asian":{"y":["2024-25"],"v":[0.2245],"n":[49.0]},"demo_pct_black":{"y":["2024-25"],"v":[0.0],"n":[49.0]},"demo_pct_ell":{"y":["2024-25"],"v":[0.4082],"n":[49.0]},"demo_pct_female":{"y":["2024-25"],"v":[0.4694],"n":[49.0]},"demo_pct_hispanic":{"y":["2024-25"],"v":[0.7347],"n":[49.0]},"demo_pct_male":{"y":["2024-25"],"v":[0.5306],"n":[49.0]},"demo_pct_multiracial":{"y":["2024-25"],"v":[0.0],"n":[49.0]},"demo_pct_native_american":{"y":["2024-25"],"v":[0.0204],"n":[49.0]},"demo_pct_other_sex":{"y":["2024-25"],"v":[0.0],"n":[49.0]},"demo_pct_poverty":{"y":["2024-25"],"v":[null],"st":["censored"],"n":[49.0],"bd":["Above 95%"]},"demo_pct_race_missing":{"y":["2024-25"],"v":[0.0],"n":[49.0]},"demo_pct_swd":{"y":["2024-25"],"v":[0.2653],"n":[49.0]},"demo_pct_white":{"y":["2024-25"],"v":[0.0204],"n":[49.0]},"lre_all":{"y":["2024-25"],"v":[0.46],"n":[13.0]},"nysesla