{"school":{"dbn":"22K240","name":"Andries Hudde","boro":"Brooklyn","district":"22","district_label":"District 22","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":397,"enrollment_year":"2024-25","address":"2500 NOSTRAND AVENUE, BROOKLYN, NY 11210","phone":"718-375-3523","website":"240steam.com","directory_url":"https://www.myschools.nyc/en/schools/middle-school/71480","accessibility":"Not Accessible","overview":"I.S. 240 Magnet School of STE(a+)M is a grade 6-8 school with a population of approximately 500 diverse students who speak over 10 different languages. Our vision is \"Building a Better World\" by developing students Global Awareness and Critical Consciousness through a Digital Platform. As a Magnet school we maintain a specialized program that includes a rich engagement of Science, Technology, Engineering, Arts in addition to all the other core content such as ELA, Social Studies, and Foreign Language. Our science program is guided by SCALES Curriculum and we incorporate community based partnerships with LEGO Education, Salvadori Center of Columbia University, Elite Learners LLC, Allergic to Salad, and Elevate Education to afford our staff with the ability to blend hands-on investigations and literacy rich activities, using digital tools to empower our students to think, read, write, and \"argue\" like real scientists. I.S. 240 is outfitted with an Innovation Robotics and 3D Printing Lab, Hydroponic Lab and Outdoor Garden, and Computer Technology Lab to immerse our students in real world learning experiences. Our ARTS program is partnered with Craftkeepers, Puppetry & Practice, and Ajna Dance Company. We incorporate partnerships with Yale Center for Emotional Intelligence and the Morningside Center for Teaching Social Responsibility as we aim to develop our school community's self-awareness of their own identity, culture, beliefs, and identify how these elements connect with the wider world. These partnerships work to support student and staff development of social awareness including empathy, appreciating diversity, respecting others, and relationship building skills, and will ultimately increase understanding of the economic, cultural, political, and environmental influences which shape all of our lives. In addition we offer a well rounded after school program to support our students interests, academic, and social emotional needs that includes The Collegiate Science & Technology Entry Program (CSTEP) at Kingsborough Community College, CAMBA, Girl Be Heard, Black P.E.A.R.L, ELA/Math Academic Support, and Title III ENL support.","start_time":"08:00am","end_time":"02:19pm","languages":null,"subway":null,"bus":"B11, B41, B44, B44-SBS, B49, B6, B7, B82, B82-SBS, B9, BM1, BM3, BM4","shared_building":"0","neighborhood":"Midwood","latitude":40.623804,"longitude":-73.946827,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.88],"st":["ok"],"n":[258.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.937,0.932,0.888,0.877,0.901,0.895,0.9],"st":["ok","ok","ok","ok","ok","ok","ok"],"n":[720.0,728.0,605.0,551.0,508.0,522.0,462.0],"c":[null,null,null,null,null,1.0,0.868]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.89],"st":["ok"],"n":[599.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.86,0.848,0.802,0.801,0.787,0.624,0.524,0.666,0.584,0.6],"st":["ok","ok","ok","ok","ok","ok","ok","ok","ok","ok"],"n":[857.0,825.0,793.0,710.0,698.0,593.0,532.0,473.0,503.0,450.0],"c":[0.825,0.795,0.79,0.776,null,null,null,0.649,0.767,0.581],"s":[4.08,3.15,2.98,3.14,null,null,null,2.99,2.04,1.2],"b":["high","above","below","above",null,null,null,"below","below","low"]},"chronic_absent_ems_allea":{"y":["2018-19","2019-20","2020-21","2021-22","20