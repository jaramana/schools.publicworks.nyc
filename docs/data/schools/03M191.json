{"school":{"dbn":"03M191","name":"The Riverside School for Makers and Artists","boro":"Manhattan","district":"03","district_label":"District 3","report_type":"EMS","report_types":"EMS","school_type":"K-8","grades":"K to 8","status":"open","enrollment":492,"enrollment_year":"2024-25","address":"300 WEST 61 STREET, Manhattan, NY 10023","phone":"917-441-1236","website":"MUSEUMMAGNET.COM","directory_url":"https://www.myschools.nyc/en/schools/middle-school/66864","accessibility":"Fully Accessible","overview":"We at RSMA are thrilled to announce that we are in our candidacy to become an accredited International Baccalaureate (IB) school. Our commitment to the IB program, particularly the Middle Years Program (MYP), reflects our dedication to providing a comprehensive and internationally recognized education. The MYP emphasizes intellectual challenge and encourages students to make connections between their studies and the real world. In addition to our core academic classes, we offer a rich array of courses in music, theater, visual arts, design and engineering, and world languages. These offerings reflect our belief in a well-rounded education that nurtures not only the intellect but also the creative spirit of our students. As part of our accelerated math program, all of our students take the Algebra I regents course. We also offer the Biology regents course, ensuring our students receive a solid foundation in the sciences. Beyond the classroom, we provide extensive after-school activities. We offer a free DYCD comprehensive after-school program and an athletics program that includes fall, winter, and spring sports teams. These programs aim to foster teamwork, discipline, and physical fitness among our students. We also provide extensive in-school enrichment activities. These include conservatory-style music and visual arts offerings, hip-hop dance, eSports, digital music creation, videography, and intramural sports. These activities provide our students with opportunities to explore their passions, develop new skills, and express their creativity. At RSMA, we strive to provide an enriching, balanced, and inclusive educational experience for all our students.","start_time":"08:10am","end_time":"02:29pm","languages":null,"subway":"1 to 66th St-Lincoln Center","bus":"BxM2, M10, M104, M11, M12, M20, M31, M5, M57, M66, M7, M72","shared_building":"1","neighborhood":"Upper West Side","latitude":40.7728,"longitude":-73.9903,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.859],"n":[229.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.903,0.91,0.823,0.818,0.837,0.803,0.825],"n":[513.0,486.0,500.0,485.0,583.0,635.0,513.0],"c":[null,null,null,null,null,0.9,0.85]},"attendance_remote_k8_all":{"y":["2020-21"],"v":[0.812],"n":[467.0]},"chronic_absent_ems_all":{"y":["2015-16","2016-17","2017-18","2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.684,0.641,0.64,0.625,0.663,0.457,0.354,0.342,0.295,0.387],"n":[395.0,396.0,480.0,504.0,469.0,464.0,469.0,558.0,613.0,478.0],"c":[0.699,0.637,0.624,0.686,null,null,null,0.521,0.608,0.578],"s":[2.68,2.12,2.96,2.35,null,null,null,1.3,1.23,1.0],"b":["below","below","below","below",null,null,null,"low","low","low"]},"chronic_absent_ems_allea":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.9,0.913,0.742,0.667,0.708,0.476,0.65],"n":[30.0,23.0,31.0,27.0,24.0,21.0,20.0],"c":[0.859,null,null,null,null,null,null]},"chronic_absent_ems_alleb":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.612,0.677,0.401,0.349,0.397,0.381,0.429],"n":[178.0,164.0,167.0,166.0,146.0,118.0,91.0],"c":[0.659,null,null,null,null,null,null]},"chronic_absent_ems_alleh":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.564,0.602,0.411,0.279,0.27,0.229,0.328],"n":[