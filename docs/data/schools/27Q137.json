{"school":{"dbn":"27Q137","name":"M.S. 137 America's School of Heroes","boro":"Queens","district":"27","district_label":"District 27","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":1611,"enrollment_year":"2024-25","address":"109-15 98 STREET, QUEENS, NY 11417","phone":"7186593140","website":"www.heroesofms137.org","directory_url":"https://www.myschools.nyc/en/schools/middle-school/68339","accessibility":"Fully Accessible","overview":"M.S. 137 America's School of Heroes is a large, diverse, urban middle school in Ozone Park, Queens. It is made up of professionals dedicated to providing every student with the support to grow emotionally, intellectually, and socially into a contributing member of a global society. We are committed to instilling the importance of education and lifelong learning, as well as college and career readiness. M.S. 137 provides its staff with professional learning that supports continued growth and best practices that promote student progress. We offer specialized classes, Regents classes, and academic intervention support services. Our recently updated Library Media Center is filled with resources and our librarian collaborates with students and staff on a variety of projects and initiatives. In addition, we provide all students with 1:1 devices to use in all subject areas. We continue to refine our curriculum to meet the goals of the Next Generation Learning Standards. We recognize the importance of collaboration between all members of our school community as a means of ensuring student success.","start_time":"08:00am","end_time":"02:19pm","languages":null,"subway":"A to 104th St-Oxford Av","bus":"BM5, Q11, Q112, Q21, Q37, Q41, Q52-SBS, Q53-SBS, Q7, QM15","shared_building":"0","neighborhood":"Ozone Park","latitude":40.6782,"longitude":-73.8396,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[