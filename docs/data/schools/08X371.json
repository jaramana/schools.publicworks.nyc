{"school":{"dbn":"08X371","name":"Urban Institute of Mathematics","boro":"Bronx","district":"08","district_label":"District 8","report_type":"EMS","report_types":"EMS","school_type":"Middle","grades":"6 to 8","status":"open","enrollment":363,"enrollment_year":"2024-25","address":"650 HOLLYWOOD AVENUE, BRONX, NY 10465","phone":"718-542-5063","website":"www.uimx371.wixsite.com/uimx371","directory_url":"https://www.myschools.nyc/en/schools/middle-school/71404","accessibility":"Partially Accessible","overview":"The Urban Institute of Mathematics (UIM) stands by our mission statement: \"I'm going to college... It's never too early to start planning for the rest of my life.\" UIM is a place where teamwork translates into STEAM work as we focus on science, technology, engineering, arts, and mathematics. Over the course of a scholar's three years at UIM they will have multiple entry points into a STEAM curriculum. Whether it be through web-design, our Makeosity Makers program, digital arts, or our math club, all scholars will be exposed to the world of STEAM. All classes are rooted in the Common Core and aim to prepare scholars for college and beyond. All scholars are enrolled in a strategic reading or mathematics period as we believe sound literacy and numeracy skills are the key to success in the future. A robust arts (including debate and mock trial) and foreign language program make for a well-rounded scholar and complement our rigorous core courses.","start_time":"08:15am","end_time":"02:35pm","languages":null,"subway":null,"bus":"Bx40, Bx42, Bx8, BxM9","shared_building":"1","neighborhood":"Throggs Neck","latitude":40.8271,"longitude":-73.8183,"coordinate_source":"geocoded","first_year":"2015-16","last_year":"2024-25"},"series":{"attendance_inperson_k8_all":{"y":["2020-21"],"v":[0.947],"n":[160.0]},"attendance_k8_all":{"y":["2018-19","2019-20","2020-21","2021-22","2022-23","2023-24","2024-25"],"v":[0.911,0.942,0.948,0.886,0.908,0.897,0.908],"n":[386.0,379.0,382.0,396.0